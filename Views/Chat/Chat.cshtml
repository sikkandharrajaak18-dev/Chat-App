    const bgState = { image: '', fit: 'cover' ,messageTimeColor:''};

    async function loadChatBackground() {
    try {
    const resp = await fetch(`/Chat/GetBackground?peerId=${receiverId}`);
    const data = await resp.json();
    if (data.backgroundImage) {
    bgState.image = data.backgroundImage;
    bgState.fit = data.backgroundFit || 'cover';
    applyChatBackground(bgState.image, bgState.fit);
    }
    if (data.messageTimeColor) {
    bgState.messageTimeColor = data.messageTimeColor;
    document.documentElement.style.setProperty('--message-time-color', data.messageTimeColor);
    document.getElementById('messageTimeColorInput').value = data.messageTimeColor;
    document.getElementById('timeColorHex').textContent = data.messageTimeColor;
    }
    } catch (e) { console.error('load bg failed', e); }
    }

    function applyChatBackground(image, fit) {
    const el = document.querySelector('.chat-messages');
    if (!image) {
    el.style.background = '';
    el.style.backgroundImage = '';
    return;
    }
    el.style.backgroundImage = '';
    if (fit === 'repeat') {
    el.style.background = `url(${image}) repeat`;
    } else {
    const size = fit === 'contain' ? 'contain' : 'cover';
    el.style.background = `url(${image}) center / ${size} no-repeat`;
    }
    }

    function SetBackground() {
    closeOptionsMenu();
