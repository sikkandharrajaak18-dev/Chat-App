    // ─── Voice Message Player ──────────────────────────────────────────────────
    // Pre-load audio as blob so duration is always known (webm stores metadata at end)
    const _vmAudioCache = {};
    const _vmAudioReady = {}; // resolved Audio objects
    const _vmTimers = {};

    async function getVmAudio(src) {
        if (!_vmAudioCache[src]) {
            _vmAudioCache[src] = (async () => {
                const resp = await fetch(src);
                if (!resp.ok) throw new Error('Fetch failed: ' + resp.status);
                const blob = await resp.blob();
                const url = URL.createObjectURL(blob);
                const audio = new Audio();
                audio.preload = 'auto';
                audio.src = url;

                // Wait for loadedmetadata (or error)
                await new Promise((resolve, reject) => {
                    audio.addEventListener('loadedmetadata', resolve, { once: true });
                    audio.addEventListener('error', reject, { once: true });
                    audio.load();
                });

                // Webm/opus stores duration at end of file and reports Infinity initially.
                // Fix: seek to a large offset — browser is forced to scan and update duration.
                if (!isFinite(audio.duration) || audio.duration <= 0) {
                    await new Promise((resolve) => {
                        const onDurationChange = () => {
                            if (isFinite(audio.duration) && audio.duration > 0) {
                                audio.removeEventListener('durationchange', onDurationChange);
                                clearTimeout(fallbackTimer);
                                audio.currentTime = 0; // rewind after seek trick
                                resolve();
                            }
                        };
                        // Timeout safety: if durationchange never fires, resolve anyway after 3s
                        const fallbackTimer = setTimeout(() => {
                            audio.removeEventListener('durationchange', onDurationChange);
                            audio.currentTime = 0;
                            resolve();
                        }, 3000);
                        audio.addEventListener('durationchange', onDurationChange);
                        // Seek to end to trigger the browser to load duration metadata
                        audio.currentTime = 1e9;
                    });
                }

                _vmAudioReady[src] = audio;
                return audio;
            })();
        }
        return _vmAudioCache[src];
    }

    async function toggleVoicePlay(btn) {
    const bubble = btn.closest('.voice-bubble-inner');
    const src = bubble.dataset.src;
    const bars = [...bubble.querySelectorAll('.vm-bar')];
    const durEl = bubble.querySelector('.vm-dur');
    const id = src;

    // If already playing → pause
    if (_vmTimers[id]) {
        clearInterval(_vmTimers[id]);
        _vmTimers[id] = null;
        const audio = _vmAudioReady[id];
        if (audio) audio.pause();
        btn.innerHTML = '<i class="fas fa-play"></i>';
        return;
    }

    // Pause any other playing bubble
    Object.keys(_vmTimers).forEach(otherId => {
    if (_vmTimers[otherId]) {
    clearInterval(_vmTimers[otherId]);
    _vmTimers[otherId] = null;
    const otherAudio = _vmAudioReady[otherId];
    if (otherAudio) { otherAudio.pause(); otherAudio.currentTime = 0; }
    const otherBubble = document.querySelector(`.voice-bubble-inner[data-src="${CSS.escape(otherId)}"]`);
    if (otherBubble) {
    const otherBtn = otherBubble.querySelector('.vm-play-btn');
    if (otherBtn) otherBtn.innerHTML = '<i class="fas fa-play"></i>';
    otherBubble.querySelectorAll('.vm-bar').forEach(b => b.classList.remove('played'));
    }
    }
    });

    // Show spinner while loading
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    btn.disabled = true;

    // Await the preloaded blob-backed audio (duration always valid)
    let audio;
    try {
        audio = await getVmAudio(src);
    } catch (err) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-play"></i>';
        console.error('Failed to load voice message:', err);
        return;
    }

    // Apply speed
    const speedBtn = bubble.querySelector('.vm-speed');
    if (speedBtn) audio.playbackRate = parseFloat(speedBtn.textContent) || 1;

    // Rewind if finished
    audio.currentTime = 0;

    // Duration is always known since we used blob URL
    const updateDisplay = () => {
    const cur = audio.currentTime;
    const dur = audio.duration;
    const hasDur = isFinite(dur) && dur > 0;
    if (hasDur) {
    const left = dur - cur;
    durEl.textContent = Math.floor(left / 60) + ':' + String(Math.floor(left % 60)).padStart(2, '0');
    const pct = cur / dur;
    const played = Math.floor(pct * bars.length);
    bars.forEach((b, i) => b.classList.toggle('played', i < played));
    } else {
        durEl.textContent = Math.floor(cur / 60) + ':' + String(Math.floor(cur % 60)).padStart(2, '0');
    }
    };

    const startPlayback = () => {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-pause"></i>';
    updateDisplay();

    _vmTimers[id] = setInterval(() => {
    if (audio.ended) {
    clearInterval(_vmTimers[id]);
    _vmTimers[id] = null;
    btn.innerHTML = '<i class="fas fa-play"></i>';
    bars.forEach(b => b.classList.remove('played'));
    durEl.textContent = '0:00';
    return;
    }
    updateDisplay();
    }, 100);
    };

    // For blob-backed audio, play is instant — no canplay wait needed
    audio.play().then(startPlayback).catch(err => {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-play"></i>';
    console.error('Voice play error:', err);
    });
    }

    const _speeds = ['1×', '1.5×', '2×'];
    function cycleVmSpeed(btn) {
    const cur = _speeds.indexOf(btn.textContent);
    const next = _speeds[(cur + 1) % _speeds.length];
    btn.textContent = next;
    const bubble = btn.closest('.voice-bubble-inner');
    const audio = _vmAudioReady[bubble.dataset.src];
    if (audio) audio.playbackRate = parseFloat(next) || 1;
    }
