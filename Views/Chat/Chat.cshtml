    connection.on("ReceiveMessage", function(sId, message, msgId, fileType, fileName) {
    document.getElementById('noMessages')?.classList.remove('show');
    if (msgId && loadedMessageIds.has(msgId)) return;
    if (msgId) loadedMessageIds.add(msgId);

    // ← ADD THIS: seed the status so the tick span renders correctly
    if (sId === senderId) {
    messageStatusMap[msgId] = { isDelivered: false, isRead: false };
    }

    appendMessage(sId, message, null, msgId, fileType, fileName, false, false, false);
    });

    connection.on("ReceiveFileMessage", function(sId, filePath, msgId, fileType, fileName,duration) {
    // Our own upload — remove the progress bubble, then fall through
    // to appendMessage so the proper message (with delete menu, ticks, etc.) is created.
    if (sId === senderId && locallyShownFiles.has(filePath)) {
    locallyShownFiles.delete(filePath);
    const temp = document.querySelector(`[data-filepath="${CSS.escape(filePath)}"]`);
    if (temp) temp.remove();
    }

    document.getElementById('noMessages')?.classList.remove('show');
    if (msgId && loadedMessageIds.has(msgId)) return;
    if (msgId) loadedMessageIds.add(msgId);
    if (sId === senderId) {
    messageStatusMap[msgId] = { isDelivered: false, isRead: false };
    }
    appendMessage(sId, filePath, null, msgId, fileType, fileName, false, false, false, false, duration);
    });

    connection.on("MessageDelivered", function(msgId) {
    // Receiver came online / received the message → double grey tick
    messageStatusMap[msgId] = { isDelivered: true, isRead: false };
    updateMessageTick(msgId);
    });

    connection.on("MessageRead", function(msgId) {
    // Receiver scrolled to and saw this specific message → double blue tick
    messageStatusMap[msgId] = { isDelivered: true, isRead: true };
    updateMessageTick(msgId);
    });

    // Handle real-time message deletion for everyone
    connection.on("MessageDeletedForEveryone", function(msgId) {
    // Store deletion timestamp in sessionStorage
    const deletedMessages = JSON.parse(sessionStorage.getItem('deletedMessages') || '{}');
    deletedMessages[msgId] = Date.now();
    sessionStorage.setItem('deletedMessages', JSON.stringify(deletedMessages));

    const wrapper = document.querySelector(`div[data-message-id="${msgId}"]`);
    if (wrapper) {
    const isSent = wrapper.classList.contains('sent');
    const bubble = wrapper.querySelector('.message-bubble');
    const meta = wrapper.querySelector('.message-meta');
    const time = meta?.querySelector('.message-time')?.textContent || new Date().toLocaleTimeString([], {hour: 'numeric', minute:'2-digit', hour12:true});
    const tickHtml = meta?.querySelector('.message-status')?.outerHTML || '';

    bubble.innerHTML = `
    <div class="message-content">
    <span class="deleted-message">This message was deleted</span>
    ${isSent ? `<button class="undo-btn" onclick="undoDelete(${msgId})">Undo</button>` : ''}
    </div>
    `;

    if (meta) {
    meta.innerHTML = `<span class="message-time">${time}</span>${tickHtml}`;
    } else {
    const metaDiv = document.createElement('div');
    metaDiv.className = 'message-meta';
    metaDiv.innerHTML = `<span class="message-time">${time}</span>${tickHtml}`;
    wrapper.appendChild(metaDiv);
    }

    if (isSent) {
    setTimeout(() => {
    const undoBtn = wrapper.querySelector('.undo-btn');
    if (undoBtn) undoBtn.remove();
    // Also remove from sessionStorage after timeout
    delete deletedMessages[msgId];
    sessionStorage.setItem('deletedMessages', JSON.stringify(deletedMessages));
    }, 30000);
    }
    }
    });

    // Handle real-time message restoration (undo)
    connection.on("MessageRestored", function(msgId, senderIdOfMsg, text, fileType, fileName, sentAt, isDelivered, isRead) {
    const wrapper = document.querySelector(`div[data-message-id="${msgId}"]`);
    if (wrapper) {
    const isSent = wrapper.classList.contains('sent');
    const bubble = wrapper.querySelector('.message-bubble');
