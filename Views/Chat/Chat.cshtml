    // ── Video thumbnail + duration ─────────────────────────────────────────────
    function initVideoCard(src, vcmId) {
    const canvas = document.getElementById(vcmId + '-canvas');
    const durBadge = document.getElementById(vcmId + '-dur');
    const fallback = document.getElementById(vcmId + '-fallback');
    if (!canvas || !durBadge) return;

    const vid = document.createElement('video');
    vid.preload = 'metadata';
    vid.muted = true;
    vid.playsInline = true;

    let settled = false;
    const failTimer = setTimeout(() => {
    if (settled) return;
    settled = true;
    durBadge.textContent = '0:00';
    if (fallback) { canvas.style.display = 'none'; fallback.classList.add('show'); }
    }, 8000);

    vid.addEventListener('loadedmetadata', () => {
    if (settled) return;
    const secs = Math.floor(vid.duration);
    if (isFinite(secs) && secs > 0) {
    durBadge.textContent = Math.floor(secs / 60) + ':' + String(secs % 60).padStart(2, '0');
    } else {
    durBadge.textContent = '0:00';
    }
    vid.currentTime = Math.min(1, vid.duration * 0.1);
    });

    vid.addEventListener('seeked', () => {
    if (settled) return;
    try {
    const ctx = canvas.getContext('2d');
    canvas.width = vid.videoWidth || 240;
    canvas.height = vid.videoHeight || 148;
    ctx.drawImage(vid, 0, 0, canvas.width, canvas.height);
    settled = true;
    clearTimeout(failTimer);
    } catch(e) {
    settled = true;
    clearTimeout(failTimer);
    if (fallback) { canvas.style.display = 'none'; fallback.classList.add('show'); }
    }
    });

    vid.addEventListener('error', () => {
    if (settled) return;
    settled = true;
    clearTimeout(failTimer);
    durBadge.textContent = '0:00';
    if (fallback) { canvas.style.display = 'none'; fallback.classList.add('show'); }
    });

    vid.src = src;
    vid.load();
    }

    function initVideoCardByEl(canvasEl) {
    if (!canvasEl) return;
    const card = canvasEl.closest('.video-card-modern');
    if (!card) return;
    const src = card.dataset.src;
    if (!src) return;
    const vcmId = canvasEl.id.replace('-canvas', '');
    initVideoCard(src, vcmId);
    }

