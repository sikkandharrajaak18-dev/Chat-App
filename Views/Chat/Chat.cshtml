    messageContent = `<div class="file-message"><div class="doc-msg-row"><a href="${text}" target="_blank" class="file-download-link"><i class="fas fa-file-alt"></i><span class="doc-name">${fileName || 'Document'}</span><span class="doc-ext">${ext2}</span></a><a href="javascript:void(0)" onclick="downloadFile('${escAttr(text)}', '${escAttr(fileName || 'document')}'); event.stopPropagation();" class="doc-dl-btn" aria-label="Download"><i class="fas fa-download"></i></a></div></div>`;
