    function selectFit(fit) {
    bgState.fit = fit;
    document.querySelectorAll('.bg-fit-btn').forEach(b => b.classList.remove('selected'));
    document.querySelector(`.bg-fit-btn[data-fit="${fit}"]`).classList.add('selected');
    updateBgPreview();
    applyChatBackground(bgState.image, bgState.fit);
    if (bgState.image) {
    fetch(`/Chat/UpdateBackgroundFit?peerId=${receiverId}&fit=${fit}`, { method: 'POST' });
    }
    }

    function selectBackgroundImage() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = async () => {
    if (!input.files[0]) return;
    const form = new FormData();
    form.append('background', input.files[0]);
    form.append('peerId', receiverId);
    form.append('backgroundFit', bgState.fit);
    try {
    const resp = await fetch('/Chat/SetBackground', { method: 'POST', body: form });
    if (resp.ok) {
    const data = await resp.json();
    bgState.image = data.backgroundImage;
    bgState.fit = data.backgroundFit || 'cover';
    updateBgPreview();
    applyChatBackground(bgState.image, bgState.fit);
    document.querySelectorAll('.bg-fit-btn').forEach(b => {
    b.classList.toggle('selected', b.dataset.fit === bgState.fit);
    });
    }
    } catch (e) { console.error(e); }
    };
    input.click();
    }

    async function removeBackground() {
    try {
    const resp = await fetch(`/Chat/RemoveBackground?peerId=${receiverId}`, { method: 'POST' });
    if (resp.ok) {
    bgState.image = '';
    updateBgPreview();
    applyChatBackground('', 'cover');
    // Reset time color to current theme default
    const t = themes.find(x => x.id === currentTheme);
    const defaultColor = t ? (t.timeColor || 'rgba(0, 0, 0, 0.5)') : 'rgba(0, 0, 0, 0.5)';
    bgState.messageTimeColor = '';
    document.documentElement.style.setProperty('--message-time-color', defaultColor);
    document.getElementById('messageTimeColorInput').value = defaultColor;
    document.getElementById('timeColorHex').textContent = defaultColor;
    await fetch(`/Chat/SetTimeColor?peerId=${receiverId}&color=`, { method: 'POST' });
    }
    } catch (e) { console.error(e); }
    }
    function formatChatTimestamps() {
        document.querySelectorAll('.msg-time[data-utc]').forEach(function(el) {
            var d = new Date(el.getAttribute('data-utc'));
            var now = new Date();
            var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            var yesterday = new Date(today);
            yesterday.setDate(yesterday.getDate() - 1);
            var md = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            var ts = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
            if (md.getTime() === today.getTime()) {
                el.textContent = ts;
            } else if (md.getTime() === yesterday.getTime()) {
                el.textContent = 'Yesterday';
            } else if (d > new Date(now.getTime() - 7 * 86400000)) {
                el.textContent = d.toLocaleDateString([], { weekday: 'long' });
            } else {
                el.textContent = d.toLocaleDateString([], { month: 'numeric', day: 'numeric', year: 'numeric' });
            }
        });
    }
    formatChatTimestamps();



    // Apply saved theme immediately before any messages render
    applyThemeStyles(currentTheme);
