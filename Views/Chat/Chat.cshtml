    const msgDateKey = msgDate.toLocaleDateString();
    const lastDateKey = lastDisplayedDate ? new Date(lastDisplayedDate).toLocaleDateString() : null;
        
    // Only add separator for NEW REAL-TIME messages (after initial load)
    if (msgDateKey !== lastDateKey && loadedMessageIds.size > pageSize) {
    insertDateSeparator(timestamp || new Date().toISOString());
    }

    const wrapper = createMessageElement(sId, message, timestamp, msgId, fileType, fileName, isDelivered, isRead, isDeleted, isStared,duration);
