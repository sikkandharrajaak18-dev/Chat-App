</style>

<script>
    const senderId = parseInt('@User.FindFirstValue(ClaimTypes.NameIdentifier)');
    const receiverId = parseInt('@ViewBag.Id');
    let connectionReady = false;
    const messageStatusMap = {};
    const loadedMessageIds = new Set(); // Track loaded messages to prevent duplicates
    let lastDisplayedDate = null;
    const pageSize = 30;
    let hasMoreMessages = true;
    let isLoadingMore = false;
    const locallyShownFiles = new Set();
    function escAttr(str) { return (str || '').replace(/'/g, "\\'"); }
    function getDateLabel(dateStr) {
    const msgDate = new Date(dateStr);
    const today = new Date();
    const msgDateStr = msgDate.toLocaleDateString();
    const todayStr = today.toLocaleDateString();
    const yesterday = new Date(today);
    yesterday.setDate(yesterday.getDate() - 1);
    const yesterdayStr = yesterday.toLocaleDateString();

    if (msgDateStr === todayStr) return 'Today';
    if (msgDateStr === yesterdayStr) return 'Yesterday';
    return msgDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'numeric', year: 'numeric' });
    }

    function insertDateSeparator(dateStr) {
    const label = getDateLabel(dateStr);
    const messagesList = document.getElementById("messages");
    const separator = document.createElement("div");
    separator.className = 'date-separator';
    separator.innerHTML = `<span>${label}</span>`;
    messagesList.appendChild(separator);
    lastDisplayedDate = dateStr;
    }

    function showConnStatus(text, className) {
    var el = document.getElementById('connStatus');
    if (el) {
    if (text) { el.textContent = text; el.style.display = 'inline'; el.className = 'conn-status ' + className; }
    else { el.style.display = 'none'; }
    }
    }

    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub")
    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
    .build();

    connection.onreconnecting(function () {
    connectionReady = false;
    showConnStatus('Reconnecting...', 'warning');
    });

    connection.onreconnected(function () {
    connectionReady = true;
    showConnStatus(null);
    connection.invoke("RegisterUser", senderId).catch(function (err) {
    console.error("Re-register failed: ", err);
    });
    });

    connection.onclose(function () {
    connectionReady = false;
    showConnStatus('Disconnected', 'error');
    setTimeout(function () { connection.start().catch(function () {}); }, 5000);
    });

   loadPastMessages();
loadChatBackground();
connection.start()
.then(function () {
    connectionReady = true;
    return connection.invoke("RegisterUser", senderId);
})
.then(function () {
    markVisibleReceivedMessagesAsRead();
})
.catch(err => console.error("Connection failed: ", err));
    // Do NOT call MarkMessagesAsRead here — the IntersectionObserver
   

    document.getElementById('messagesContainer').addEventListener('scroll', function () {
    if (this.scrollTop <= 5 && hasMoreMessages && !isLoadingMore) {
    loadMoreMessages();
    }
    });

    async function loadPastMessages() {
    try {
    lastDisplayedDate = null;
    hasMoreMessages = true;

    const deletedMessages = JSON.parse(sessionStorage.getItem('deletedMessages') || '{}');

    const response = await fetch(`/Chat/GetMessages?receiverId=${receiverId}&take=${pageSize}`);
    const data = await response.json();
    const messages = data.messages || [];
    hasMoreMessages = data.hasMore;

    console.log('Loaded messages:', messages); // Debug log

    // FIXED: Group messages by date first, then append with separators
    let previousDateLabel = null;
            
    messages.forEach(msg => {
    if (msg.messageId && loadedMessageIds.has(msg.messageId)) return;
    if (msg.messageId) loadedMessageIds.add(msg.messageId);

    if (msg.senderId === senderId) {
    messageStatusMap[msg.messageId] = {
    isDelivered: msg.isDelivered,
    isRead: msg.isRead
    };
    }
                
    // Get the date label for this message
    const currentDateLabel = getDateLabel(msg.sentAt);
                
    // Add date separator if date changed
    if (currentDateLabel !== previousDateLabel) {
    const messagesList = document.getElementById("messages");
    const separator = document.createElement("div");
    separator.className = 'date-separator';
    separator.innerHTML = `<span>${currentDateLabel}</span>`;
    messagesList.appendChild(separator);
    previousDateLabel = currentDateLabel;
    lastDisplayedDate = msg.sentAt;
    }
                
    // Append the message without date separator logic since we already added it
    const messagesList = document.getElementById("messages");
    const wrapper = createMessageElement(msg.senderId, msg.text, msg.sentAt, msg.messageId, msg.fileType, msg.fileName, msg.isDelivered, msg.isRead, msg.isDeleted, msg.isStared,msg.duration);
    messagesList.appendChild(wrapper);
                
    if (msg.senderId !== senderId) {
    observeReceivedMessage(wrapper, msg.senderId);
    }
                
    // Add delete menu
    {
    const menuDiv = document.createElement("div");
    menuDiv.className = "delete-menu";
    menuDiv.id = `menu-${wrapper.dataset.messageId}`;
                    
    let menuItems = '';
    const isSent = (msg.senderId === senderId);
    if (isSent) {
    const starLabel = msg.isStared ? 'Unmark Star' : 'Mark as Starred';
    const starIcon = msg.isStared ? 'fa-solid fa-ban' : 'fa-regular fa-star';
    menuItems += `
    <div class="delete-menu-item delete-for-me" onclick="deleteForMe(${wrapper.dataset.messageId})">
    <i class="fas fa-trash-alt"></i> Delete for me
    </div>
    <div class="delete-menu-item delete-for-everyone" onclick="deleteForEveryone(${wrapper.dataset.messageId})">
    <i class="fas fa-users"></i> Delete for everyone
    </div>
    <div class="delete-menu-item" onclick="toggleStarred(${wrapper.dataset.messageId}, ${msg.isStared})">
    <i class="${starIcon}"></i> ${starLabel}
    </div>`;
    if (msg.fileType) {
    menuItems += `
    <div class="delete-menu-item" onclick="downloadFile('${escAttr(msg.text)}', '${escAttr(msg.fileName || msg.fileType)}')">
    <i class="fas fa-download"></i> Download
    </div>`;
    }
    } else {
    const starLabel = msg.isStared ? 'Unmark Star' : 'Mark as Starred';
    const starIcon = msg.isStared ? 'fa-solid fa-ban' : 'fa-regular fa-star';
    menuItems += `
    <div class="delete-menu-item delete-for-me" onclick="deleteForMe(${wrapper.dataset.messageId})">
    <i class="fas fa-trash-alt"></i> Delete for me
    </div>
    <div class="delete-menu-item" onclick="toggleStarred(${wrapper.dataset.messageId}, ${msg.isStared})">
    <i class="${starIcon}"></i> ${starLabel}
    </div>`;
    if (msg.fileType) {
    menuItems += `
    <div class="delete-menu-item" onclick="downloadFile('${escAttr(msg.text)}', '${escAttr(msg.fileName || msg.fileType)}')">
    <i class="fas fa-download"></i>  Download
    </div>`;
    }
    }
                    
    menuDiv.innerHTML = menuItems;
    document.body.appendChild(menuDiv);
    }
    });

            


    const noMessages = document.getElementById('noMessages');
    if (messages.length === 0) {
    noMessages.classList.add('show');
    } else {
    noMessages.classList.remove('show');
    }
    scrollToBottom();
    } catch (err) {
    console.error("Failed to load past messages: ", err);
    } finally {
    document.getElementById('chatLoading').classList.add('hidden');
    requestAnimationFrame(() => {
    requestAnimationFrame(() => scrollToBottom());
    });
    }
    }

    function sendMessage() {
    if (!connectionReady) {
    showConnStatus('Reconnecting...', 'warning');
    setTimeout(sendMessage, 2000);
    return;
    }
    if (isNaN(senderId) || isNaN(receiverId)) { return; }

    const messageInput = document.getElementById("txtMessage");
    const message = messageInput.value;
    if (!message.trim()) return;

    messageInput.value = "";
    messageInput.focus();
    connection.invoke("SendMessage", senderId, receiverId, message)
    .catch(function (err) {
    console.error("Send failed: ", err);
    showConnStatus('Reconnecting...', 'warning');
    });
    }

    function handleKeyPress(event) {
    if (event.key === 'Enter') {
    sendMessage();
    }
    }

    let currentDeleteMenu = null;

    function createMessageElement(sId, message, timestamp, msgId, fileType, fileName, isDelivered, isRead, isDeleted, isStared = false,duration=null) {
    const isSent = (sId === senderId);
    const wrapper = document.createElement("div");
    wrapper.className = isSent ? 'message-wrapper sent' : 'message-wrapper received';
    wrapper.dataset.messageId = msgId || Date.now();
    wrapper.dataset.sentAt = timestamp || new Date().toISOString();

    const time = timestamp
    ? new Date(timestamp).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }).replace(".",":")
    : new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }).replace(".",":");

    let tickHtml = '';
    if (isSent) {
    const status = messageStatusMap[wrapper.dataset.messageId] || { isDelivered: isDelivered || false, isRead: isRead || false };
    if (status.isRead) {
    tickHtml = '<span class="message-status read"><i class="fas fa-check-double"></i></span>';
    } else if (status.isDelivered) {
    tickHtml = '<span class="message-status delivered"><i class="fas fa-check-double"></i></span>';
    } else {
    tickHtml = '<span class="message-status"><i class="fas fa-check"></i></span>';
    }
    }

    if (isDeleted) {
    const deletedMessages = JSON.parse(sessionStorage.getItem('deletedMessages') || '{}');
    const deletionTime = deletedMessages[msgId];
    const showUndo = deletionTime && (Date.now() - deletionTime < 30000);

    wrapper.innerHTML = `
    <div class="message-bubble">
    <div class="message-content">
    <span class="deleted-message">This message was deleted</span>
    ${isSent && showUndo ? '<button class="undo-btn" onclick="undoDelete(' + wrapper.dataset.messageId + ')">Undo</button>' : ''}
    </div>
    </div>
    <div class="message-meta">
    <span class="message-time">${time}</span>
    ${tickHtml}
    </div>
    `;

    if (isSent && showUndo) {
    setTimeout(() => {
    const undoBtn = wrapper.querySelector('.undo-btn');
    if (undoBtn) undoBtn.remove();
    delete deletedMessages[msgId];
    sessionStorage.setItem('deletedMessages', JSON.stringify(deletedMessages));
    }, 30000);
    }
    document.getElementById('noMessages')?.classList.remove('show');

    return wrapper;
    }

    const deleteIconHtml = `
    <i class="fas fa-ellipsis-h delete-icon" onclick="showDeleteMenu(event, ${wrapper.dataset.messageId}, ${sId}, this, '${fileType || ''}', '${escAttr(fileName)}', '${escAttr(message)}', ${isStared})"></i>
    `;

    const starIconHtml = isStared ? `<i class="fas fa-star starred-icon" style="color: #fbbf24; margin-left: 8px;"></i>` : '';

    let messageContent = message;
    if (fileType) {
    if (fileType === 'image') {
    messageContent = `<div class="img-msg-wrap"><img src="${message}" alt="${fileName || 'Image'}" /><a href="javascript:void(0)" onclick="downloadFile('${escAttr(message)}', '${escAttr(fileName || 'image')}'); event.stopPropagation();" class="img-dl-btn" aria-label="Download"><i class="fas fa-download"></i></a></div>`;
   } else if (fileType === 'video') {
    const vcmId = 'vcm-' + (msgId || Math.random().toString(36).slice(2));
    const durStr = duration != null
        ? Math.floor(duration / 60) + ':' + String(Math.floor(duration % 60)).padStart(2, '0')
        : '--:--';
    messageContent = `
    <div class="video-card-modern" data-src="${message}" onclick="openVideoPlayer('${message}')">
      <div class="vcm-thumb" style="position:relative;">
        <canvas class="vcm-canvas" id="${vcmId}-canvas" style="display:block;"></canvas>
        <i class="fas fa-film vcm-film-icon vcm-film-fallback" id="${vcmId}-fallback"></i>
        <div class="vcm-play-overlay">
          <div class="vcm-big-play"><i class="fas fa-play"></i></div>
        </div>
        <span class="vcm-duration-badge" id="${vcmId}-dur">${durStr}</span>
      </div>
      
    </div>`;
   if (duration == null) {
    setTimeout(() => initVideoCardByEl(document.getElementById(`${vcmId}-canvas`)), 0);
}
    } else if (fileType === 'document') {
    const ext = (fileName || '').split('.').pop().toUpperCase() || 'FILE';
    messageContent = `<div class="doc-msg-row"><a href="${message}" target="_blank" class="file-download-link"><i class="fas fa-file-alt"></i><span class="doc-name">${fileName || 'Document'}</span><span class="doc-ext">${ext}</span></a><a href="javascript:void(0)" onclick="downloadFile('${escAttr(message)}', '${escAttr(fileName || 'document')}'); event.stopPropagation();" class="doc-dl-btn" aria-label="Download"><i class="fas fa-download"></i></a></div>`;
    } else if (fileType === 'audio') {
    const bars = Array.from({length:30}, (_,i) => {
