    function closeBackgroundPopup() {
    document.getElementById('bgOverlay').classList.remove('show');
    document.getElementById('bgPopup').classList.remove('show');
    }
    async function setTimeColor(color) {
    bgState.messageTimeColor = color;
    document.documentElement.style.setProperty('--message-time-color', color);
    document.getElementById('timeColorHex').textContent = color;
    await fetch(`/Chat/SetTimeColor?peerId=${receiverId}&color=${encodeURIComponent(color)}`, { method: 'POST' });
    }

    function updateBgPreview() {
    const preview = document.getElementById('bgPreview');
    if (bgState.image) {
    if (bgState.fit === 'repeat') {
    preview.style.background = `url(${bgState.image}) repeat`;
    } else {
    const size = bgState.fit === 'contain' ? 'contain' : 'cover';
    preview.style.background = `url(${bgState.image}) center / ${size} no-repeat`;
    }
    } else {
    preview.style.background = 'linear-gradient(180deg, #f8fafc, #f1f5f9)';
