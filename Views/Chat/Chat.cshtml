    async function loadMoreMessages() {
    if (isLoadingMore || !hasMoreMessages) return;

    isLoadingMore = true;

    const messagesContainer = document.getElementById('messagesContainer');
    const messagesList = document.getElementById('messages');

    // Loading spinner
    const loadingEl = document.createElement('div');
    loadingEl.className = 'chat-loading';
    loadingEl.id = 'loadMoreLoading';
    loadingEl.style.padding = '20px';
    loadingEl.innerHTML = `
    <div class="loading-spinner"
    style="width:30px;height:30px;border-width:3px">
    </div>
    `;

    messagesList.prepend(loadingEl);

    try {

    // Oldest loaded message
    const firstWrapper = document.querySelector('#messages .message-wrapper');

    let before = null;
    let beforeId = null;

    if (firstWrapper) {
    before = firstWrapper.dataset.sentAt;
    beforeId = parseInt(firstWrapper.dataset.messageId);
    }

    if (!before || !beforeId) {
    hasMoreMessages = false;
    return;
    }

    const params = new URLSearchParams({
    receiverId: receiverId,
    before: before,
    beforeId: beforeId,
    take: pageSize
    });

    const response = await fetch(`/Chat/GetMessages?${params}`);

    const data = await response.json();

    const messages = data.messages || [];

    hasMoreMessages = data.hasMore;

    if (messages.length === 0) {
    hasMoreMessages = false;
    return;
    }

    // Save old scroll height
    const oldScrollHeight = messagesContainer.scrollHeight;

    const fragment = document.createDocumentFragment();

    // Get the date key of the oldest message already in the DOM
    const firstExistingWrapper = document.querySelector('#messages .message-wrapper');
    const existingOldestDateKey = firstExistingWrapper
    ? new Date(firstExistingWrapper.dataset.sentAt).toLocaleDateString()
    : null;

    // Track date across the batch independently
    let lastFragmentDateKey = null;

    messages.forEach((msg) => {

    // Prevent duplicates
    if (msg.messageId && loadedMessageIds.has(msg.messageId)) {
    return;
    }

    if (msg.messageId) {
    loadedMessageIds.add(msg.messageId);
    }

    // Store message status
    if (msg.senderId === senderId) {
    messageStatusMap[msg.messageId] = {
    isDelivered: msg.isDelivered,
    isRead: msg.isRead
    };
    }

    const msgDateKey = new Date(msg.sentAt).toLocaleDateString();

    // Insert a separator every time the date changes within this batch
    if (msgDateKey !== lastFragmentDateKey) {
    const separator = document.createElement('div');
    separator.className = 'date-separator';
    separator.innerHTML = `<span>${getDateLabel(msg.sentAt)}</span>`;
    fragment.appendChild(separator);
    lastFragmentDateKey = msgDateKey;
    }

    // Create message element
    const wrapper = createMessageElement(
    msg.senderId,
    msg.text,
    msg.sentAt,
    msg.messageId,
    msg.fileType,
    msg.fileName,
    msg.isDelivered,
    msg.isRead,
    msg.isDeleted,
    msg.isStared,
    msg.duration
    );

    fragment.appendChild(wrapper);

    // Read observer
    if (msg.senderId !== senderId) {
    observeReceivedMessage(wrapper, msg.senderId);
    }
    });

    // Remove loading spinner
    loadingEl.remove();

    // Prepend messages
    messagesList.prepend(fragment);

    // After prepend: if the batch's last date matches the existing oldest
    // message's date, remove the now-duplicate separator from the DOM
    if (lastFragmentDateKey && lastFragmentDateKey === existingOldestDateKey) {
    const allSeps = messagesList.querySelectorAll('.date-separator');
    if (allSeps.length >= 2) {
    const s1 = allSeps[0].querySelector('span').innerText.trim();
    const s2 = allSeps[1].querySelector('span').innerText.trim();
    if (s1 === s2) allSeps[1].remove();
    }
    }

    // Maintain scroll position
    const newScrollHeight = messagesContainer.scrollHeight;

    messagesContainer.scrollTop =
    newScrollHeight - oldScrollHeight;

    }
    catch (err) {
    console.error("Failed to load more messages:", err);
    }
    finally {

    const loader = document.getElementById('loadMoreLoading');

    if (loader) {
    loader.remove();
    }

    isLoadingMore = false;
    }
    }
    function showDeleteMenu(event, messageId, senderIdOfMessage, icon, fileType, fileName, messageUrl, isStared) {
    event.preventDefault();
    event.stopPropagation();
    closeDeleteMenu();

    const menu = document.getElementById(`menu-${messageId}`);
    if (menu) {
    menu.style.visibility = 'hidden';
    menu.classList.add('show');

    const menuWidth = menu.offsetWidth;
    const menuHeight = menu.offsetHeight;

    let left = event.clientX - menuWidth;
    let top = event.clientY + 5;

    if (left < 0) left = 10;
    if (top + menuHeight > window.innerHeight) {
    top = event.clientY - menuHeight - 5;
    }

    menu.style.left = `${left}px`;
    menu.style.top = `${top}px`;
    menu.style.visibility = 'visible';
    currentDeleteMenu = menu;
    }
    }

    async function toggleStarred(messageId, isCurrentlyStared) {
    try {
    const endpoint = isCurrentlyStared ? '/Chat/MessageUnstarred' : '/Chat/MessageStared';
    const response = await fetch(`${endpoint}?messageId=${messageId}`, {
    method: 'POST'
    });
    if (response.ok) {
    console.log(isCurrentlyStared ? "Message Unstarred" : "Message Starred");
    closeDeleteMenu();

    const wrapper = document.querySelector(`div[data-message-id="${messageId}"]`);
    if (wrapper) {
    const messageContent = wrapper.querySelector('.message-content');
    if (messageContent) {
    if (isCurrentlyStared) {
    // Remove star icon
    const starIcon = messageContent.querySelector('.starred-icon');
    if (starIcon) {
    starIcon.remove();
    }
    } else {
    // Add star icon - insert before the delete icon
    if (!messageContent.querySelector('.starred-icon')) {
    const starIcon = document.createElement('i');
    starIcon.className = 'fas fa-star starred-icon';
    starIcon.style.color = '#fbbf24';
    starIcon.style.marginLeft = '8px';
    // Insert before the delete icon, or at the end if no delete icon
    const deleteIcon = messageContent.querySelector('.delete-icon');
    if (deleteIcon) {
    messageContent.insertBefore(starIcon, deleteIcon);
    } else {
    messageContent.appendChild(starIcon);
    }
    }
    }
    }
    }

    // Update the menu text for next time
    const menu = document.getElementById(`menu-${messageId}`);
    if (menu) {
    const newIsStared = !isCurrentlyStared;
    const starLabel = newIsStared ? 'Unmark Star' : 'Mark as Starred';
    const starIcon = newIsStared ? 'fa-solid fa-ban' : 'fa-regular fa-star';
    const starMenuItem = menu.querySelector('div[onclick^="toggleStarred"]');
    if (starMenuItem) {
    starMenuItem.setAttribute('onclick', `toggleStarred(${messageId}, ${newIsStared})`);
    starMenuItem.innerHTML = `<i class="${starIcon}"></i> ${starLabel}`;
    }
    }
    }
    }
    catch(error){
    console.log(error);
    }
    }

    function closeDeleteMenu() {
    if (currentDeleteMenu) {
    currentDeleteMenu.classList.remove('show');
    currentDeleteMenu.style.visibility = 'hidden';
    currentDeleteMenu = null;
    }
    }

    function forwardMessage(messageId, message, fileType, fileName) {
