@{
    ViewData["Title"] = "Forward Message";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --primary-color: #6366f1;
        --bg-gradient: linear-gradient(135deg, #e0e7ff 0%, #f0e6ff 50%, #e8e0f7 100%);
        --surface: #ffffff;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg-gradient);
        min-height: 100vh;
    }

    .forward-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        min-height: 100vh;
    }

    .forward-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background: var(--surface);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.15);
        margin-bottom: 20px;
    }

    .back-btn {
        width: 44px;
        height: 44px;
        background: var(--primary-color);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: all 0.3s;
    }

    .back-btn:hover {
        transform: translateX(-2px);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .forward-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .message-preview {
        background: var(--surface);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.1);
    }

    .message-preview-label {
        font-size: 12px;
        color: var(--text-secondary);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .message-preview-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .message-preview-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
        flex-shrink: 0;
    }

    .message-preview-text {
        flex: 1;
        color: var(--text-primary);
        font-size: 14px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .message-preview-file {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .section-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 20px 0 12px 4px;
    }

    .recipients-list {
        background: var(--surface);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.1);
    }

    .recipient-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        cursor: pointer;
        transition: all 0.2s;
        border-bottom: 1px solid #f3f4f6;
    }

    .recipient-item:last-child {
        border-bottom: none;
    }

    .recipient-item:hover {
        background: #f9fafb;
    }

    .recipient-item.selected {
        background: #eef2ff;
    }

    .recipient-avatar {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 18px;
        flex-shrink: 0;
        overflow: hidden;
        position: relative;
    }

    .recipient-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .recipient-info {
        flex: 1;
        min-width: 0;
    }

    .recipient-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .recipient-name .forwarded-badge {
        font-size: 10px;
        font-weight: 500;
        background: #e0e7ff;
        color: #6366f1;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .recipient-status {
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 2px;
    }

    .online-indicator {
        width: 10px;
        height: 10px;
        background: #34d399;
        border-radius: 50%;
        border: 2px solid white;
        position: absolute;
        bottom: 0;
        right: 0;
    }

    .forward-btn {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
        padding: 16px 28px;
        border-radius: 16px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
        transition: all 0.3s;
        display: none;
        z-index: 100;
    }

    .forward-btn.visible {
        display: block;
    }

    .forward-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(99, 102, 241, 0.5);
    }

    .group-avatar {
        background: linear-gradient(135deg, #f093fb, #f5576c);
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-secondary);
    }

    .empty-state i {
        font-size: 40px;
        margin-bottom: 12px;
        opacity: 0.5;
    }

    .toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        background: #1f2937;
        color: white;
        padding: 12px 24px;
        border-radius: 12px;
        font-size: 14px;
        opacity: 0;
        transition: all 0.3s;
        z-index: 1000;
    }

    .toast.show {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }

    .loading-spinner {
        width: 30px;
        height: 30px;
        border: 3px solid #f3f4f6;
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 40px auto;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .no-message-state {
        text-align: center;
        padding: 60px 20px;
    }

    .no-message-state i {
        font-size: 60px;
        color: #d1d5db;
        margin-bottom: 16px;
    }

    .no-message-state h3 {
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .no-message-state p {
        color: var(--text-secondary);
    }
</style>

<div class="forward-container" id="mainContainer">
    <!-- Header -->
    <div class="forward-header">
        <a href="/Chat/Index" class="back-btn">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div class="forward-title">Forward to</div>
    </div>

    <!-- Message Preview -->
    <div class="message-preview" id="messagePreview" style="display: none;">
        <div class="message-preview-label">Forwarding message</div>
        <div class="message-preview-content">
            <div class="message-preview-icon" id="messageIcon">
                <i class="fas fa-comment"></i>
            </div>
            <div>
                <div class="message-preview-text" id="messageText"></div>
                <div class="message-preview-file" id="messageFileName" style="display: none;"></div>
            </div>
        </div>
    </div>

    <!-- No Message State -->
    <div class="no-message-state" id="noMessageState">
        <i class="fas fa-share-alt"></i>
        <h3>No message selected</h3>
        <p>Go back and select a message to forward</p>
        <a href="/Chat/Index" style="display: inline-block; margin-top: 16px; color: var(--primary-color);">Go to Chats</a>
    </div>

    <!-- Loading -->
    <div class="loading-spinner" id="loadingSpinner"></div>

    <!-- Users Section -->
    <div id="usersSection" style="display: none;">
        <div class="section-title">Users</div>
        <div class="recipients-list" id="usersList"></div>
    </div>

    <!-- Groups Section -->
    <div id="groupsSection" style="display: none;">
        <div class="section-title">Groups</div>
        <div class="recipients-list" id="groupsList"></div>
    </div>

    <!-- Empty State -->
    <div class="empty-state" id="emptyState" style="display: none;">
        <i class="fas fa-users"></i>
        <p>No users or groups to forward to</p>
    </div>
</div>

<!-- Forward Button -->
<button class="forward-btn" id="forwardBtn" onclick="forwardMessage()">
    <i class="fas fa-paper-plane"></i> Forward
</button>

<!-- Toast -->
<div class="toast" id="toast">Message forwarded successfully!</div>

<script>
    let selectedRecipients = [];
    let forwardData = null;

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', async function() {
        // Read message from sessionStorage
        const storedData = sessionStorage.getItem('forwardMessage');
        if (storedData) {
            forwardData = JSON.parse(storedData);
            displayMessagePreview(forwardData);
        }

        // Load recipients from server
        await loadRecipients();
    });

    function displayMessagePreview(data) {
        if (!data) return;

        document.getElementById('noMessageState').style.display = 'none';
        document.getElementById('messagePreview').style.display = 'block';
        document.getElementById('messageText').textContent = data.message || data.text || '';

        const iconEl = document.getElementById('messageIcon');
        const fileNameEl = document.getElementById('messageFileName');

        if (data.fileType) {
            fileNameEl.style.display = 'block';
            fileNameEl.textContent = data.fileName || data.fileType;

            if (data.fileType.startsWith('image')) {
                iconEl.innerHTML = '<i class="fas fa-image"></i>';
            } else if (data.fileType.startsWith('video')) {
                iconEl.innerHTML = '<i class="fas fa-video"></i>';
            } else if (data.fileType === 'audio') {
                iconEl.innerHTML = '<i class="fas fa-microphone"></i>';
            } else {
                iconEl.innerHTML = '<i class="fas fa-file"></i>';
            }
        } else {
            iconEl.innerHTML = '<i class="fas fa-comment"></i>';
        }
    }

    async function loadRecipients() {
        try {
            const response = await fetch('/Chat/GetForwardRecipients');
            const data = await response.json();

            document.getElementById('loadingSpinner').style.display = 'none';

            if (data.users && data.users.length > 0) {
                renderUsers(data.users);
                document.getElementById('usersSection').style.display = 'block';
            }

            if (data.groups && data.groups.length > 0) {
                renderGroups(data.groups);
                document.getElementById('groupsSection').style.display = 'block';
            }

            if ((!data.users || data.users.length === 0) && (!data.groups || data.groups.length === 0)) {
                document.getElementById('emptyState').style.display = 'block';
            }
        } catch (error) {
            console.error('Error loading recipients:', error);
            document.getElementById('loadingSpinner').style.display = 'none';
            document.getElementById('emptyState').style.display = 'block';
        }
    }

    function renderUsers(users) {
        const container = document.getElementById('usersList');
        container.innerHTML = users.map(user => `
            <div class="recipient-item" data-id="${user.id}" data-type="user" onclick="toggleSelection(${user.id}, 'user', this)">
                <div class="recipient-avatar">
                    ${user.profileImagePath ? `<img src="${user.profileImagePath}" alt="${user.username}" />` : user.username.charAt(0).toUpperCase()}
                    ${user.isOnline ? '<span class="online-indicator"></span>' : ''}
                </div>
                <div class="recipient-info">
                    <div class="recipient-name">${user.username}</div>
                    <div class="recipient-status">${user.isOnline ? 'Online' : 'Offline'}</div>
                </div>
            </div>
        `).join('');
    }

    function renderGroups(groups) {
        const container = document.getElementById('groupsList');
        container.innerHTML = groups.map(group => `
            <div class="recipient-item" data-id="${group.groupId}" data-type="group" onclick="toggleSelection(${group.groupId}, 'group', this)">
                <div class="recipient-avatar group-avatar">
                    ${group.profileImagePath ? `<img src="${group.profileImagePath}" alt="${group.groupName}" />` : '<i class="fas fa-users"></i>'}
                </div>
                <div class="recipient-info">
                    <div class="recipient-name">
                        ${group.groupName}
                        <span class="forwarded-badge">Forwarded</span>
                    </div>
                    <div class="recipient-status">${group.userIds ? group.userIds.length : 0} members</div>
                </div>
            </div>
        `).join('');
    }

    function toggleSelection(id, type, element) {
        const index = selectedRecipients.findIndex(r => r.id === id && r.type === type);

        if (index > -1) {
            selectedRecipients.splice(index, 1);
            element.classList.remove('selected');
        } else {
            selectedRecipients.push({ id: id, type: type });
            element.classList.add('selected');
        }

        updateForwardButton();
    }

    function updateForwardButton() {
        const btn = document.getElementById('forwardBtn');
        if (selectedRecipients.length > 0 && forwardData) {
            btn.classList.add('visible');
            btn.innerHTML = `<i class="fas fa-paper-plane"></i> Forward to ${selectedRecipients.length}`;
        } else {
            btn.classList.remove('visible');
        }
    }

    async function forwardMessage() {
        if (selectedRecipients.length === 0 || !forwardData) return;

        const btn = document.getElementById('forwardBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';

        const request = {
            messageId: forwardData.messageId,
            text: forwardData.message || forwardData.text,
            fileType: forwardData.fileType,
            fileName: forwardData.fileName,
            recipients: selectedRecipients
        };

        try {
            const response = await fetch('/Chat/ForwardMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(request)
            });

            const result = await response.json();

            if (result.success) {
                showToast('Message forwarded successfully!');
                sessionStorage.removeItem('forwardMessage');
                setTimeout(() => {
                    window.location.href = '/Chat/Index';
                }, 1000);
            } else {
                showToast(result.message || 'Failed to forward message');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Forward';
            }
        } catch (error) {
            console.error('Error forwarding message:', error);
            showToast('An error occurred');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Forward';
        }
    }

    function showToast(message) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.classList.add('show');
        setTimeout(() => {
            toast.classList.remove('show');
        }, 3000);
    }

</script>
