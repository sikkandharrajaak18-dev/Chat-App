<script>
    const senderId = parseInt('@ViewBag.CurrentUserId');
    const senderName = '@ViewBag.CurrentUserName';
    const senderProfileImage = '@ViewBag.CurrentUserProfileImage';
    const groupId = parseInt('@ViewBag.GroupId');
    let connectionReady = false;
    const loadedMessageIds = new Set();
    let lastDisplayedDate = null;
    const pageSize = 30;
    let hasMoreMessages = true;
    let isLoadingMore = false;
    const messageStatusMap = {};
    const locallyShownFiles = new Set();

    function showConnStatus(text, className) {
        var el = document.getElementById('connStatus');
        if (el) {
            if (text) { el.textContent = text; el.style.display = 'inline'; el.className = 'conn-status ' + className; }
            else { el.style.display = 'none'; }
        }
    }

    let currentFileMenu = null;
    let currentDeleteMenu = null;
    let currentEmojiPicker = null;
    let emojiPickerInstance = null;
    let emojiPickerVisible = false;

  async function toggleEmojiPicker(event) {
    event.preventDefault();
    event.stopPropagation();

    const container = document.getElementById('emojiPickerContainer');

    if (emojiPickerVisible) {
        closeEmojiPicker();
        return;
    }

    closeEmojiPicker();

    if (!emojiPickerInstance) {
        try {
            const response = await fetch('https://cdn.jsdelivr.net/npm/@@emoji-mart/data');
            const data = await response.json();
            emojiPickerInstance = new EmojiMart.Picker({
                data: data,
                onEmojiSelect: (emoji) => {
                    insertEmoji(emoji.native);
                },
                theme: 'light',
                set: 'native',
            });
            container.appendChild(emojiPickerInstance);
        } catch (err) {
            console.error('Emoji picker failed:', err);
            return;
        }
    }

    container.classList.add('show');
    emojiPickerVisible = true;
    currentEmojiPicker = container;
}

    function closeEmojiPicker() {
        const container = document.getElementById('emojiPickerContainer');
        container.classList.remove('show');
        emojiPickerVisible = false;
        currentEmojiPicker = null;
    }

    function insertEmoji(emoji) {
        const input = document.getElementById('txtMessage');
        const startPos = input.selectionStart;
        const endPos = input.selectionEnd;
        const value = input.value;
        input.value = value.substring(0, startPos) + emoji + value.substring(endPos);
        input.selectionStart = input.selectionEnd = startPos + emoji.length;
        input.focus();
        closeEmojiPicker();
    }

    function getDateLabel(dateStr) {
        const msgDate = new Date(dateStr);
        const today = new Date();
        const msgDateStr = msgDate.toLocaleDateString();
        const todayStr = today.toLocaleDateString();
        const yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);
        const yesterdayStr = yesterday.toLocaleDateString();

        if (msgDateStr === todayStr) return 'Today';
        if (msgDateStr === yesterdayStr) return 'Yesterday';
        return msgDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'numeric', year: 'numeric' });
    }

    function insertDateSeparator(dateStr) {
        const label = getDateLabel(dateStr);
        const messagesList = document.getElementById("messages");
        const separator = document.createElement("div");
        separator.className = 'date-separator';
        separator.innerHTML = `<span>${label}</span>`;
        messagesList.appendChild(separator);
        lastDisplayedDate = dateStr;
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();

    connection.onreconnecting(function () {
        connectionReady = false;
        showConnStatus('Reconnecting...', 'warning');
    });

    connection.onreconnected(function () {
        connectionReady = true;
        showConnStatus(null);
        connection.invoke("RegisterUser", senderId).catch(function (err) {
            console.error("Re-register failed: ", err);
        });
    });

    connection.onclose(function () {
        connectionReady = false;
        showConnStatus('Disconnected', 'error');
        setTimeout(function () { connection.start().catch(function () {}); }, 5000);
    });

   loadPastMessages();
connection.start()
    .then(function () {
        connectionReady = true;
        return connection.invoke("RegisterUser", senderId);
    })
    .catch(err => console.error("Connection failed: ", err));

    document.getElementById('messagesContainer').addEventListener('scroll', function () {
        if (this.scrollTop <= 5 && hasMoreMessages && !isLoadingMore) {
            loadMoreMessages();
        }
    });

    async function loadPastMessages() {
        try {
            lastDisplayedDate = null;
            hasMoreMessages = true;

            const response = await fetch(`/Chat/GetGroupMessages?groupId=${groupId}&take=${pageSize}`);
            const data = await response.json();
            const messages = data.messages;
            hasMoreMessages = data.hasMore;

            messages.forEach(msg => {
                if (msg.groupMessageId && loadedMessageIds.has(msg.groupMessageId)) return;
                if (msg.groupMessageId) loadedMessageIds.add(msg.groupMessageId);
                if (msg.senderId === senderId && msg.groupMessageId) {
                    messageStatusMap[msg.groupMessageId] = {
                        deliveredCount: msg.deliveredCount || 0,
                        readCount: msg.readCount || 0,
                        totalRecipients: msg.totalRecipients || 0
                    };
                }
                appendMessage(msg.senderId, msg.senderName, msg.senderProfileImage, msg.text, msg.sentAt, msg.groupMessageId, msg.fileType, msg.fileName, msg.isDeleted || false, msg.deliveredCount || 0, msg.readCount || 0, msg.totalRecipients || 0, msg.isStared || false, msg.duration);
            });

            const noMessages = document.getElementById('noMessages');
        if (messages.length === 0) {
            noMessages.classList.add('show');
        } else {
            noMessages.classList.remove('show');
        }
            scrollToBottom();
        } catch (err) {
            console.error("Failed to load messages: ", err);
        } finally {
            document.getElementById('chatLoading').classList.add('hidden');
            requestAnimationFrame(() => {
                requestAnimationFrame(() => scrollToBottom());
            });
        }
    }

    let pendingMessages = new Map();

    function sendMessage() {
        if (!connectionReady) {
            showConnStatus('Reconnecting...', 'warning');
            setTimeout(sendMessage, 2000);
            return;
        }
        const messageInput = document.getElementById("txtMessage");
        const message = messageInput.value;
        if (!message.trim()) return;

        const tempId = 'temp_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        const now = new Date().toISOString();

        // Optimistically display message immediately
        appendMessage(senderId, senderName, senderProfileImage, message, now, tempId, null, null, false, 0, 0, 0, false);

        // Store pending message for later update
        pendingMessages.set(tempId, { text: message, timestamp: now });

        messageInput.value = "";
        messageInput.focus();

        connection.invoke("SendGroupMessage", senderId, groupId, message)
            .catch(err => {
                console.error("Send failed: ", err);
                showConnStatus('Reconnecting...', 'warning');
                // Remove optimistic message on failure
                const wrapper = document.querySelector(`div[data-message-id="${tempId}"]`);
                if (wrapper) wrapper.remove();
            });
    }

    function handleKeyPress(event) {
        if (event.key === 'Enter') {
            sendMessage();
        }
    }

    function escapeJsString(str) {
        if (!str) return '';
        return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    }

    function getGroupMessageMenuHtml(messageId, isSent, fileType, filePath, fileName, isStared) {
        let items = '';
        if (isSent) {
            const starLabel = isStared ? 'Unmark Star' : 'Mark as Starred';
            const starIcon = isStared ? 'fa-star' : 'fa-regular fa-star';
            items += `
                <div class="delete-menu-item delete-for-me" onclick="deleteForMe(${messageId})">
                    <i class="fas fa-trash-alt"></i> Delete for me
                </div>
                <div class="delete-menu-item delete-for-everyone" onclick="deleteForEveryone(${messageId})">
                    <i class="fas fa-users"></i> Delete for everyone
                </div>
                <div class="delete-menu-item" onclick="toggleGroupStarred(${messageId}, ${isStared})">
                    <i class="${starIcon}"></i> ${starLabel}
                </div>`;
            if (fileType) {
                items += `
                <div class="delete-menu-item download-item" onclick="downloadFile('${escapeJsString(filePath)}', '${escapeJsString(fileName || fileType)}'); closeDeleteMenu();">
                    <i class="fas fa-download"></i> Download
                </div>`;
            }
        } else {
            const starLabel = isStared ? 'Unmark Star' : 'Mark as Starred';
            const starIcon = isStared ? 'fa-star' : 'fa-regular fa-star';
            items += `
                <div class="delete-menu-item delete-for-me" onclick="deleteForMe(${messageId})">
                    <i class="fas fa-trash-alt"></i> Delete for me
                </div>
                <div class="delete-menu-item" onclick="toggleGroupStarred(${messageId}, ${isStared})">
                    <i class="${starIcon}"></i> ${starLabel}
                </div>`;
            if (fileType) {
                items += `
                <div class="delete-menu-item download-item" onclick="downloadFile('${escapeJsString(filePath)}', '${escapeJsString(fileName || fileType)}'); closeDeleteMenu();">
                    <i class="fas fa-download"></i> Download
                </div>`;
            }
        }
        return items;
    }

    function attachGroupMessageMenu(messageId, isSent, fileType, filePath, fileName, isStared) {

        const menuHtml = getGroupMessageMenuHtml(messageId, isSent, fileType, filePath, fileName, isStared);
        if (!menuHtml.trim()) return;

        const existing = document.getElementById(`menu-${messageId}`);
        if (existing) existing.remove();

        const menuDiv = document.createElement('div');
        menuDiv.className = 'delete-menu';
        menuDiv.id = `menu-${messageId}`;
        menuDiv.innerHTML = menuHtml;
        document.body.appendChild(menuDiv);
    }

    function createMessageElement(sId, sName, sProfileImg, message, timestamp, msgId, fileType, fileName, isDeleted, deliveredCount, readCount, totalRecipients, isStared, duration) {
        const isSent = (sId === senderId);
        const wrapper = document.createElement("div");
        wrapper.className = isSent ? 'message-wrapper sent' : 'message-wrapper received';
        wrapper.dataset.messageId = msgId || Date.now();
        wrapper.dataset.sentAt = timestamp || new Date().toISOString();

        const time = timestamp ? new Date(timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

        const status = messageStatusMap[msgId];
        const dCount = status ? status.deliveredCount : (deliveredCount || 0);
        const rCount = status ? status.readCount : (readCount || 0);
        const tCount = status ? status.totalRecipients : (totalRecipients || 0);

        let tickHtml = '';
        if (isSent) {
            if (tCount > 0 && rCount >= tCount) {
                tickHtml = '<span class="message-status read" onclick="showGroupMessageStatus(event, ' + msgId + ')" title="Read by everyone"><i class="fas fa-check-double"></i></span>';
            } else if (tCount > 0 && dCount >= tCount) {
                tickHtml = '<span class="message-status delivered" onclick="showGroupMessageStatus(event, ' + msgId + ')" title="Delivered to everyone"><i class="fas fa-check-double"></i></span>';
            } else {
                tickHtml = '<span class="message-status" onclick="showGroupMessageStatus(event, ' + msgId + ')" title="Sent"><i class="fas fa-check"></i></span>';
            }
        }

        if (isDeleted) {
            const deletedMessages = JSON.parse(sessionStorage.getItem('deletedMessages') || '{}');
            const deletionTime = deletedMessages[msgId];
            const showUndo = isSent && deletionTime && (Date.now() - deletionTime < 30000);

            wrapper.innerHTML = `
                <div class="message-sender-info">
                    <div class="message-sender-avatar">
                        ${sProfileImg ? `<img src="${sProfileImg}" alt="${sName}" />` : (sName ? sName.charAt(0).toUpperCase() : '?')}
                    </div>
                    <span class="message-sender-name">${sName || 'Unknown'}</span>
                </div>
                <div class="message-bubble">
                    <div class="message-content">
                        <span class="deleted-message">This message was deleted</span>
                        ${showUndo ? '<button class="undo-btn" onclick="undoGroupDelete(' + msgId + ')">Undo</button>' : ''}
                    </div>
                </div>
                <div class="message-meta">
                    <span class="message-time">${time}</span>
                    ${tickHtml}
                </div>
            `;

            if (isSent && showUndo) {
                setTimeout(() => {
                    const undoBtn = wrapper.querySelector('.undo-btn');
                    if (undoBtn) undoBtn.remove();
                    delete deletedMessages[msgId];
                    sessionStorage.setItem('deletedMessages', JSON.stringify(deletedMessages));
                }, 30000);
            }

            return wrapper;
        }

        const initial = sName ? sName.charAt(0).toUpperCase() : '?';
        const profileImgHtml = sProfileImg ? `<img src="${sProfileImg}" alt="${sName}" />` : initial;

        const deleteIconHtml = `
            <i class="fas fa-ellipsis-h delete-icon" onclick="showDeleteMenu(event, ${wrapper.dataset.messageId}, this, ${isStared})"></i>
        `;
        const starIconHtml = isStared ? `<i class="fas fa-star starred-icon" style="color: #fbbf24; margin-left: 8px;"></i>` : '';

        let messageContent = '';
        if (fileType) {
            if (fileType === 'image') {
                messageContent = `<div class="file-message"><img src="${message}" alt="${fileName || 'Image'}" /></div>`;
            } else if (fileType === 'video') {
              const vcmId = 'vcm-' + (msgId || Math.random().toString(36).slice(2));
              const durStr = duration != null
                  ? Math.floor(duration / 60) + ':' + String(Math.floor(duration % 60)).padStart(2, '0')
                  : '--:--';
              messageContent = `
<div class="video-card-modern" data-src="${message}" onclick="openVideoPlayer('${escapeJsString(message)}')">
  <div class="vcm-thumb" style="position:relative;">
    <canvas class="vcm-canvas" id="${vcmId}-canvas" style="width:100%;height:148px;display:block;object-fit:cover;"></canvas>
    <i class="fas fa-film vcm-film-icon vcm-film-fallback" id="${vcmId}-fallback"></i>
    <div class="vcm-play-overlay">
      <div class="vcm-big-play"><i class="fas fa-play"></i></div>
    </div>
    <span class="vcm-duration-badge" id="${vcmId}-dur">${durStr}</span>
  </div>
  <div class="vcm-footer">
    <a href="javascript:void(0)" onclick="downloadFile('${escapeJsString(message)}', '${escapeJsString(fileName || 'video')}'); event.stopPropagation();" class="vcm-dl" aria-label="Download"><i class="fas fa-download"></i></a>
  </div>
</div>`;
              if (duration == null) {
                  setTimeout(() => initVideoCardByEl(document.getElementById(`${vcmId}-canvas`)), 0);
              }
            } else if (fileType === 'document') {
                messageContent = `<div class="file-message"><a href="${message}" target="_blank" class="file-download-link"><i class="fas fa-file-alt"></i> ${fileName || 'Document'}</a></div>`;
            } else if (fileType === 'audio') {
             const bars = Array.from({length:30}, (_,i) => {
  const h = 8 + Math.round(Math.abs(Math.sin(i*0.7+(msgId||0))*22));
  return `<div class="vm-bar" style="height:${h}px"></div>`;
}).join('');
messageContent = `
<div class="voice-bubble-inner" data-src="${message}">
  <button class="vm-play-btn" onclick="toggleVoicePlay(this)" aria-label="Play voice message">
    <i class="fas fa-play"></i>
  </button>
  <div class="vm-waveform-area">
    <div class="vm-bars">${bars}</div>
    <div class="vm-meta">
      <span class="vm-dur">0:00</span>
      <button class="vm-speed" onclick="cycleVmSpeed(this)">1×</button>
    </div>
  </div>
</div>`;
            }
        } else {
            messageContent = `<span>${message}</span>`;
        }

        wrapper.innerHTML = `
            <div class="message-sender-info">
                <div class="message-sender-avatar">${profileImgHtml}</div>
                <span class="message-sender-name">${sName || 'Unknown'}</span>
            </div>
            <div class="message-bubble">
                <div class="message-content">
                    ${messageContent}
                    ${starIconHtml}
                    ${deleteIconHtml}
                </div>
            </div>
            <div class="message-meta">
                <span class="message-time">${time}</span>
                ${tickHtml}
            </div>
        `;

        return wrapper;
    }

    async function downloadFile(url, fileName) {
    try {
        const response = await fetch(url);
        const blob = await response.blob();
        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = fileName || 'download';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(blobUrl);
    } catch (err) {
        window.open(url, '_blank');
    }
}

    function appendMessage(sId, sName, sProfileImg, message, timestamp, msgId, fileType, fileName, isDeleted, deliveredCount, readCount, totalRecipients, isStared, duration) {
        document.getElementById('noMessages')?.classList.remove('show');
        const messagesList = document.getElementById("messages");

        const msgDate = timestamp ? new Date(timestamp) : new Date();
        const msgDateKey = msgDate.toLocaleDateString();
        const lastDateKey = lastDisplayedDate ? new Date(lastDisplayedDate).toLocaleDateString() : null;
        if (msgDateKey !== lastDateKey) {
            insertDateSeparator(timestamp || new Date().toISOString());
        }

        if (sId === senderId && msgId) {
            if (!messageStatusMap[msgId]) {
                messageStatusMap[msgId] = {
                    deliveredCount: deliveredCount || 0,
                    readCount: readCount || 0,
                    totalRecipients: totalRecipients || 0
                };
            }
        }

        const wrapper = createMessageElement(sId, sName, sProfileImg, message, timestamp, msgId, fileType, fileName, isDeleted, deliveredCount, readCount, totalRecipients, isStared, duration);
        messagesList.appendChild(wrapper);

        if (sId !== senderId && msgId) {
            observeGroupMessage(wrapper, msgId);
        }

        attachGroupMessageMenu(wrapper.dataset.messageId, sId === senderId, fileType, message, fileName, isStared);

        scrollToBottom();
    }

    async function loadMoreMessages() {
        isLoadingMore = true;
        const messagesList = document.getElementById('messages');
        const loadingEl = document.createElement('div');
        loadingEl.className = 'chat-loading';
        loadingEl.id = 'loadMoreLoading';
        loadingEl.style.padding = '20px';
        loadingEl.innerHTML = '<div class="loading-spinner" style="width:30px;height:30px;border-width:3px"></div>';
        messagesList.prepend(loadingEl);

        try {
            const firstWrapper = document.querySelector('#messages .message-wrapper');
            let before = null;
            let beforeId = null;
            if (firstWrapper && firstWrapper.dataset.sentAt) {
                before = firstWrapper.dataset.sentAt;
                beforeId = parseInt(firstWrapper.dataset.messageId);
            }
            if (!before || !beforeId) {
                hasMoreMessages = false;
                return;
            }

            const params = new URLSearchParams({
                groupId: groupId,
                before: before,
                beforeId: beforeId,
                take: pageSize
            });
            const response = await fetch(`/Chat/GetGroupMessages?${params}`);
            const data = await response.json();
            hasMoreMessages = data.hasMore;

            if (data.messages.length === 0) {
                hasMoreMessages = false;
                return;
            }

            const oldScrollHeight = document.getElementById('messagesContainer').scrollHeight;
            const fragment = document.createDocumentFragment();
            let batchLastDisplayedDate = null;

            data.messages.forEach(msg => {
                if (msg.groupMessageId && loadedMessageIds.has(msg.groupMessageId)) return;
                if (msg.groupMessageId) loadedMessageIds.add(msg.groupMessageId);

                if (msg.senderId === senderId && msg.groupMessageId) {
                    messageStatusMap[msg.groupMessageId] = {
                        deliveredCount: msg.deliveredCount || 0,
                        readCount: msg.readCount || 0,
                        totalRecipients: msg.totalRecipients || 0
                    };
                }

                const msgDate = msg.sentAt ? new Date(msg.sentAt) : new Date();
                const msgDateKey = msgDate.toLocaleDateString();
                const batchLastKey = batchLastDisplayedDate ? new Date(batchLastDisplayedDate).toLocaleDateString() : null;
                if (msgDateKey !== batchLastKey) {
                    const sep = document.createElement('div');
                    sep.className = 'date-separator';
                    sep.innerHTML = `<span>${getDateLabel(msg.sentAt)}</span>`;
                    fragment.appendChild(sep);
                    batchLastDisplayedDate = msg.sentAt;
                }

                const isStared = msg.isStared || false;
                const wrapper = createMessageElement(msg.senderId, msg.senderName, msg.senderProfileImage, msg.text, msg.sentAt, msg.groupMessageId, msg.fileType, msg.fileName, msg.isDeleted || false, msg.deliveredCount || 0, msg.readCount || 0, msg.totalRecipients || 0, isStared, msg.duration);
                fragment.appendChild(wrapper);

                if (msg.senderId !== senderId && msg.groupMessageId) {
                    observeGroupMessage(wrapper, msg.groupMessageId);
                }

                attachGroupMessageMenu(wrapper.dataset.messageId, msg.senderId === senderId, msg.fileType, msg.text, msg.fileName, isStared);
            });

            messagesList.prepend(fragment);

            if (data.messages.length > 0) {
                lastDisplayedDate = data.messages[0].sentAt;
            }

            requestAnimationFrame(() => {
                document.getElementById('messagesContainer').scrollTop = document.getElementById('messagesContainer').scrollHeight - oldScrollHeight;
            });
        } catch (err) {
            console.error("Failed to load more messages: ", err);
        } finally {
            const el = document.getElementById('loadMoreLoading');
            if (el) el.remove();
            isLoadingMore = false;
        }
    }

    function showDeleteMenu(event, messageId, icon, isStared) {
        event.preventDefault();
        event.stopPropagation();
        closeDeleteMenu();

        const menu = document.getElementById(`menu-${messageId}`);
        if (menu) {
            menu.style.visibility = 'hidden';
            menu.classList.add('show');

            const menuWidth = menu.offsetWidth;
            const menuHeight = menu.offsetHeight;

            let left = event.clientX - menuWidth;
            let top = event.clientY + 5;

            if (left < 0) left = 10;
            if (top + menuHeight > window.innerHeight) {
                top = event.clientY - menuHeight - 5;
            }

            menu.style.left = `${left}px`;
            menu.style.top = `${top}px`;
            menu.style.visibility = 'visible';
            currentDeleteMenu = menu;
        }
    }

    function closeDeleteMenu() {
        if (currentDeleteMenu) {
            currentDeleteMenu.classList.remove('show');
            currentDeleteMenu.style.visibility = 'hidden';
            currentDeleteMenu = null;
        }
    }

    async function toggleGroupStarred(messageId, isCurrentlyStared) {
        try {
            const endpoint = isCurrentlyStared ? '/Chat/GroupMessageUnstarred' : '/Chat/GroupMessageStared';
            const response = await fetch(`${endpoint}?messageId=${messageId}`, {
                method: 'POST'
            });
            if (response.ok) {
                closeDeleteMenu();

                const wrapper = document.querySelector(`div[data-message-id="${messageId}"]`);
                if (wrapper) {
                    const messageContent = wrapper.querySelector('.message-content');
                    if (messageContent) {
                        if (isCurrentlyStared) {
                            const starIcon = messageContent.querySelector('.starred-icon');
                            if (starIcon) {
                                starIcon.remove();
                            }
                        } else {
                            if (!messageContent.querySelector('.starred-icon')) {
                                const starIcon = document.createElement('i');
                                starIcon.className = 'fas fa-star starred-icon';
                                starIcon.style.cssText = 'color: #fbbf24; margin-left: 8px;';
                                const deleteIcon = messageContent.querySelector('.delete-icon');
                                if (deleteIcon) {
                                    messageContent.insertBefore(starIcon, deleteIcon);
                                } else {
                                    messageContent.appendChild(starIcon);
                                }
                            }
                        }
                    }
                }

                const menu = document.getElementById(`menu-${messageId}`);
                if (menu) {
                    const newIsStared = !isCurrentlyStared;
                    const starLabel = newIsStared ? 'Unmark Star' : 'Mark as Starred';
                    const starIcon = newIsStared ? 'fa-star' : 'fa-regular fa-star';
                    const starMenuItem = menu.querySelector('div[onclick^="toggleGroupStarred"]');
                    if (starMenuItem) {
                        starMenuItem.setAttribute('onclick', `toggleGroupStarred(${messageId}, ${newIsStared})`);
                        starMenuItem.innerHTML = `<i class="${starIcon}"></i> ${starLabel}`;
                    }
                }
            }
        } catch (error) {
            console.log(error);
        }
    }

    document.addEventListener('click', function(event) {
        if (currentDeleteMenu && !currentDeleteMenu.contains(event.target)) {
            closeDeleteMenu();
        }
        if (currentFileMenu && !currentFileMenu.contains(event.target) && !event.target.closest('.attach-btn') && !event.target.closest('.attach-btn *')) {
            closeFileMenu();
        }
        if (currentEmojiPicker && !currentEmojiPicker.contains(event.target) && !event.target.closest('.emoji-btn')) {
            closeEmojiPicker();
        }
    });
    
     async function deleteForMe(messageId) {
        try {
            const response = await fetch(`/Chat/DeleteGroupMessageForMe?messageid=${messageId}`, { method: 'POST' });

            if (response.ok) {
                const wrapper = document.querySelector(`div[data-message-id="${messageId}"]`);
                const menu = document.getElementById(`menu-${messageId}`);

                if (wrapper) wrapper.remove();
