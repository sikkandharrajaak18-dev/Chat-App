<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/emoji-mart@5.6.0/dist/browser.js"></script>

<div class="group-chat-wrapper">
    <div class="group-chat-header">
        <div class="header-left">
            <a href="/Chat/Index" class="back-btn">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div class="group-avatar">
                @if (!string.IsNullOrEmpty(ViewBag.ProfileImagePath))
                {
                    <img src="@ViewBag.ProfileImagePath" alt="@ViewBag.GroupName" />
                }
                else
                {
                    <i class="fas fa-users"></i>
                }
            </div>
            <div class="group-info">
                <div class="group-name">@ViewBag.GroupName</div>
                <div class="group-member-count">@ViewBag.Members.Count members</div>
                <span class="conn-status" id="connStatus" style="display:none;"></span>
            </div>
        </div>
        <div class="header-right">
            <div class="header-icon" onclick="changeTheme()" title="Change Theme">
                <i class="fas fa-palette"></i>
            </div>
            <div class="header-icon" onclick="toggleMembersList()" title="Members">
                <i class="fas fa-user-friends"></i>
            </div>
        </div>
    </div>

    <div class="members-sidebar" id="membersSidebar">
        <div class="members-sidebar-header">
            <h4><i class="fas fa-user-friends"></i> Members</h4>
            <button class="close-sidebar-btn" onclick="toggleMembersList()"><i class="fas fa-times"></i></button>
        </div>
        <div class="members-sidebar-list">
            @foreach (var member in ViewBag.Members)
            {
                <div class="member-item">
                    <div class="member-avatar">
                        @if (!string.IsNullOrEmpty(member.ProfileImagePath))
                        {
                            <img src="@member.ProfileImagePath" alt="@member.username" />
                        }
                        else
                        {
                            <span>@member.username.Substring(0, 1).ToUpper()</span>
                        }
                    </div>
                    <div class="member-info">
                        <span class="member-name">@member.username</span>
                        @if (member.IsOnline)
                        {
                            <span class="member-status-text online">Online</span>
                        }
                        else
                        {
                            <span class="member-status-text offline">Offline</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="group-messages" id="messagesContainer">
        <div class="messages-list" id="messages"></div>
       <div class="no-messages" id="noMessages">
            <div class="no-messages-icon"><i class="fas fa-comment-dots"></i></div>
            <div class="no-messages-text">Start chatting</div>
        </div>
        <div class="chat-loading" id="chatLoading">
            <div class="loading-spinner"></div>
            <div class="loading-text">Loading messages...</div>
        </div>
    </div>

    <div class="group-input-area">
        <div id="emojiPickerContainer" class="emoji-picker-container"></div>
        <div class="recording-timer" id="recordingTimer" style="display:none;">
            <span class="recording-dot"></span>
            <span class="recording-duration" id="recordingDuration">0:00</span>
            <span class="recording-label">Recording...</span>
        </div>
        <div class="input-wrapper">
            <button class="attach-btn" onclick="toggleFileMenu(event)" title="Attach file">
                <i class="fas fa-plus"></i>
            </button>
            <button class="emoji-btn" onclick="toggleEmojiPicker(event)" title="Emoji">
                <i class="far fa-smile-wink"></i>
            </button>
            <button class="mic-btn" id="micBtn" onclick="toggleRecording()" title="Voice message">
                <i class="fas fa-microphone"></i>
            </button>
            <input type="text" id="txtMessage" placeholder="Type a message..." onkeypress="handleKeyPress(event)" />
            <button class="send-btn" onclick="sendMessage()">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <div class="file-menu" id="fileMenu">
        <div class="file-menu-item" onclick="selectFile('image')">
            <div class="file-icon image-icon"><i class="fas fa-image"></i></div>
            <span>Images</span>
        </div>
        <div class="file-menu-item" onclick="selectFile('video')">
            <div class="file-icon video-icon"><i class="fas fa-video"></i></div>
            <span>Videos</span>
        </div>
        <div class="file-menu-item" onclick="selectFile('document')">
            <div class="file-icon doc-icon"><i class="fas fa-file-alt"></i></div>
            <span>Documents</span>
        </div>
    </div>

    <input type="file" id="imageInput" accept="image/*" style="display:none" onchange="uploadGroupFile(this, 'image')" />
    <input type="file" id="videoInput" accept="video/*" style="display:none" onchange="uploadGroupFile(this, 'video')" />
    <input type="file" id="documentInput" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv" style="display:none" onchange="uploadGroupFile(this, 'document')" />
</div>

<!-- Video Player Modal -->
<div class="vcm-modal-overlay" id="vcmPlayerOverlay">
    <div class="vcm-modal-close" onclick="closeVideoPlayer()"><i class="fas fa-times"></i></div>
    <video class="vcm-modal-video" id="vcmPlayerVideo" controls playsinline></video>
</div>

<style>
    :root {
        --chat-header-bg: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        --chat-messages-bg: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        --sent-bubble-bg: linear-gradient(135deg, #6366f1, #8b5cf6);
        --recv-bubble-bg: #ffffff;
        --btn-bg: linear-gradient(135deg, #6366f1, #8b5cf6);
        --primary-color: #6366f1;
        --primary-light: #a5b4fc;
        --primary-dark: #4f46e5;
        --surface-elevated: #ffffff;
        --shadow-soft: 0 4px 20px rgba(99, 102, 241, 0.15);
        --shadow-message: 0 2px 12px rgba(0, 0, 0, 0.08);
        --icon-color: #64748b;
        --icon-bg: rgba(0, 0, 0, 0.05);
        --message-text-color: #1e293b;
        --date-separator-bg: linear-gradient(135deg, #f8fafc, #f1f5f9);
        --date-separator-text: #64748b;
        --date-separator-border: #e2e8f0;
        --message-meta-color: #64748b;
    }

    html, body {
        height: 100%;
        overflow: hidden;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #e0e7ff 0%, #f0e6ff 50%, #e8e0f7 100%);
        margin-bottom: 0 !important;
    }

    .group-chat-wrapper {
        position: fixed;
        inset: 0;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        height: 100vh;
        height: 100dvh;
        background: var(--chat-messages-bg);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(99, 102, 241, 0.25);
        border-radius: 0;
    }

    @@media (min-width: 768px) {
        .group-chat-wrapper {
            top: 20px;
            bottom: 20px;
            left: 50%;
            right: auto;
            transform: translateX(-50%);
            width: 100%;
            max-width: 900px;
            height: auto;
            border-radius: 24px;
        }
    }

    .group-chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        background: var(--chat-header-bg);
        color: white;
        flex-shrink: 0;
        z-index: 100;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .back-btn {
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .back-btn:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateX(-2px);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .group-avatar {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(255,255,255,0.3), rgba(255,255,255,0.1));
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 20px;
        font-weight: 700;
        border: 2px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .group-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 16px;
    }

    .group-info {
        display: flex;
        flex-direction: column;
    }

    .group-name {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.3px;
    }

    .group-member-count {
        font-size: 13px;
        opacity: 0.9;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .header-icon:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: rotate(90deg);
    }

    .members-sidebar {
        position: fixed;
        top: 0;
        right: -340px;
        width: 340px;
        height: 100vh;
        background: var(--surface-elevated);
        box-shadow: -8px 0 32px rgba(0, 0, 0, 0.2);
        z-index: 200;
        transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        border-left: 1px solid rgba(0, 0, 0, 0.05);
    }

    .members-sidebar.open {
        right: 0;
    }

    .members-sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: var(--chat-header-bg);
    }

    .members-sidebar-header h4 {
        font-size: 18px;
        color: white;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

    .members-sidebar-header h4 i {
        margin-right: 10px;
    }

    .close-sidebar-btn {
        width: 36px;
        height: 36px;
        border: none;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        transition: all 0.2s;
    }

    .close-sidebar-btn:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: rotate(90deg);
    }

    .members-sidebar-list {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
    }

    .members-sidebar-list::-webkit-scrollbar {
        width: 4px;
    }

    .members-sidebar-list::-webkit-scrollbar-track {
        background: transparent;
    }

    .members-sidebar-list::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 2px;
    }

    .members-sidebar-list .member-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        border-radius: 14px;
        transition: all 0.2s;
        margin-bottom: 4px;
    }

    .members-sidebar-list .member-item:hover {
        background: linear-gradient(90deg, #f8fafc 0%, #f1f5f9 100%);
        transform: translateX(4px);
    }

    .members-sidebar-list .member-avatar {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }

    .members-sidebar-list .member-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 14px;
    }

    .member-info {
        display: flex;
        flex-direction: column;
    }

    .member-info .member-name {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
    }

    .member-status-text {
        font-size: 12px;
        margin-top: 2px;
    }

    .member-status-text.online {
        color: #22c55e;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .member-status-text.online::before {
        content: '';
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.1); }
    }

    .member-status-text.offline {
        color: #64748b;
    }

    .sidebar-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.4);
        z-index: 150;
        display: none;
        animation: fadeIn 0.3s ease;
    }

    .sidebar-overlay.show {
        display: block;
    }

    .group-messages {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 24px;
        background: var(--chat-messages-bg);
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .group-messages::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 100px;
        background: linear-gradient(180deg, var(--chat-messages-bg) 0%, transparent 100%);
        pointer-events: none;
        z-index: 1;
    }

    .messages-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        position: relative;
        z-index: 0;
    }

    .message-wrapper {
        display: flex;
        flex-direction: column;
        max-width: 70%;
        animation: messageIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes messageIn {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .message-wrapper.sent {
        align-self: flex-end;
    }

    .message-wrapper.received {
        align-self: flex-start;
    }

    .message-sender-info {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        padding-left: 4px;
    }

    .message-wrapper.sent .message-sender-info {
        display: none;
    }

    .message-sender-avatar {
        width: 28px;
        height: 28px;
        border-radius: 10px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        flex-shrink: 0;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.4);
    }

    .message-sender-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .message-sender-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--primary-color);
    }

    .message-bubble {
        padding: 14px 18px;
        border-radius: 22px;
        position: relative;
        word-wrap: break-word;
        font-size: 15px;
        line-height: 1.55;
        box-shadow: var(--shadow-message);
        transition: all 0.2s ease;
    }

    .message-wrapper.sent .message-bubble {
        background: var(--sent-bubble-bg);
        color: white;
        border-bottom-right-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .message-wrapper.received .message-bubble {
        background: var(--recv-bubble-bg);
        color: var(--message-text-color);
        border-bottom-left-radius: 6px;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .message-wrapper:hover .message-bubble {
        transform: translateY(-1px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    .message-content {
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .message-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 5px;
        font-size: 11px;
        opacity: 0.7;
        color: var(--message-meta-color);
    }

    .message-wrapper.sent .message-meta {
        justify-content: flex-end;
    }

    .message-status {
        display: flex;
        align-items: center;
        transition: all 0.2s ease;
    }

    .message-status.delivered {
        color: #94a3b8;
    }

    .message-status.read {
        color: #60a5fa;
    }

    .delete-icon {
        opacity: 0;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
        padding: 6px;
        margin-left: 8px;
        color: var(--icon-color, #64748b);
        background: var(--icon-bg, rgba(0, 0, 0, 0.05));
        border-radius: 8px;
    }

    .message-wrapper:hover .delete-icon {
        opacity: 0.8;
    }

    .delete-icon:hover {
        opacity: 1 !important;
        background: rgba(99, 102, 241, 0.15);
        color: var(--primary-color);
    }

    .starred-icon {
        color: gold;
        font-size: 14px;
        flex-shrink: 0;
    }

    .message-wrapper.sent .delete-icon {
        color: rgba(255, 255, 255, 0.8);
        background: rgba(255, 255, 255, 0.15);
    }

    .message-wrapper.received .delete-icon {
        color: var(--icon-color, #64748b);
        background: var(--icon-bg, rgba(0, 0, 0, 0.05));
    }

    .deleted-message {
        font-style: italic;
        opacity: 0.7;
        color: inherit;
    }

    .undo-btn {
        background: rgba(99, 102, 241, 0.15);
        border: none;
        color: var(--primary-color);
        cursor: pointer;
        font-size: 12px;
        margin-left: 10px;
        padding: 4px 10px;
        border-radius: 8px;
        transition: all 0.2s;
        font-weight: 600;
    }

    .undo-btn:hover {
        background: rgba(99, 102, 241, 0.25);
        transform: translateY(-1px);
    }

    .date-separator {
        display: flex;
        justify-content: center;
        margin: 20px 0;
        position: relative;
    }

    .date-separator::before,
    .date-separator::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--date-separator-border), transparent);
    }

    .date-separator::before { left: 0; }
    .date-separator::after { right: 0; }

    .date-separator span {
        background: var(--date-separator-bg);
        color: var(--date-separator-text);
        font-size: 12px;
        font-weight: 600;
        padding: 8px 20px;
        border-radius: 20px;
        text-transform: capitalize;
        border: 1px solid var(--date-separator-border);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .group-input-area {
        position: relative;
        flex-shrink: 0;
        padding: 20px 24px;
        padding-bottom: calc(20px + env(safe-area-inset-bottom));
        background: var(--surface-elevated);
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    .input-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 30px;
        padding: 10px 12px 10px 24px;
        border: 2px solid transparent;
        transition: all 0.3s ease;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
    }

    .input-wrapper:focus-within {
        border-color: var(--primary-light);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1), inset 0 2px 4px rgba(0, 0, 0, 0.03);
    }

    .attach-btn {
        width: 42px;
        height: 42px;
        border: none;
        background: var(--btn-bg);
        border-radius: 50%;
        color: white;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        flex-shrink: 0;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .attach-btn:hover {
        transform: scale(1.08) rotate(90deg);
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
    }

    #txtMessage {
        flex: 1;
        padding: 12px;
        border: none;
        outline: none;
        font-size: 16px;
        background: transparent;
        font-family: inherit;
        color: #1e293b;
    }

    #txtMessage::placeholder {
        color: #94a3b8;
    }

    .send-btn {
        width: 46px;
        height: 46px;
        border: none;
        background: var(--btn-bg);
        border-radius: 50%;
        color: white;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        flex-shrink: 0;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .send-btn:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
    }

    .send-btn:active {
        transform: scale(0.95);
    }

    emoji-picker {
        width: 100% !important;
    }

    .emoji-btn {
        width: 42px;
        height: 42px;
        border: none;
        background: transparent;
        border-radius: 50%;
        color: #64748b;
        font-size: 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .emoji-btn:hover {
        color: var(--primary-color);
