    async function deleteForEveryone(messageId) {
        try {
            const response = await fetch(`/Chat/DeleteGroupMessageForEveryOne?messageid=${messageId}`, { method: 'POST' });
            // Store deletion timestamp in sessionStorage
            const deletedMessages = JSON.parse(sessionStorage.getItem('deletedMessages') || '{}');
            deletedMessages[messageId] = Date.now();
            sessionStorage.setItem('deletedMessages', JSON.stringify(deletedMessages));
            closeDeleteMenu();
        } catch (error) {
            console.log(error);
        }
    }


    connection.on("ReceiveGroupMessage", function(sId, sName, sProfileImg, gId, message, msgId, sentAt) {
        if (msgId && loadedMessageIds.has(msgId)) return;
        if (msgId) loadedMessageIds.add(msgId);

        // Check if this is our own message that was optimistically added
        const pendingKey = Array.from(pendingMessages.keys()).find(key =>
            pendingMessages.get(key).text === message && sId === senderId
        );

        if (pendingKey) {
            // Replace optimistic message with real one
            const tempWrapper = document.querySelector(`div[data-message-id="${pendingKey}"]`);
            if (tempWrapper) {
                tempWrapper.dataset.messageId = msgId;

                // Update message status tracking
                if (msgId) {
                    messageStatusMap[msgId] = { deliveredCount: 0, readCount: 0, totalRecipients: 0 };
                }

                // Update menu with new ID
                attachGroupMessageMenu(msgId, true, null, message, null);

                // Remove from pending
                pendingMessages.delete(pendingKey);

                // Update tick for our own message
                if (msgId) {
                    updateGroupMessageTick(msgId);
                }

                return;
            }
        }

        if (sId !== senderId && msgId && connectionReady) {
            connection.invoke("MarkGroupMessageDelivered", msgId, groupId, senderId);
        }

        if (sId === senderId && msgId) {
            if (!messageStatusMap[msgId]) {
                messageStatusMap[msgId] = { deliveredCount: 0, readCount: 0, totalRecipients: 0 };
            }
        }

        appendMessage(sId, sName, sProfileImg, message, sentAt, msgId, null, null, false, 0, 0, 0, false);
    });

    connection.on("ReceiveGroupFileMessage", function(sId, sName, sProfileImg, gId, filePath, msgId, fileType, fileName, sentAt, duration) {
        // Remove temp upload bubble if present
        var existing = document.querySelector('[data-filepath="' + CSS.escape(filePath) + '"]');
        if (existing) existing.remove();
        locallyShownFiles['delete'](filePath);

        if (msgId && loadedMessageIds.has(msgId)) return;
        if (msgId) loadedMessageIds.add(msgId);

        if (sId !== senderId && msgId && connectionReady) {
            connection.invoke("MarkGroupMessageDelivered", msgId, groupId, senderId);
        }

        if (sId === senderId && msgId) {
            if (!messageStatusMap[msgId]) {
                messageStatusMap[msgId] = { deliveredCount: 0, readCount: 0, totalRecipients: 0 };
            }
        }

        appendMessage(sId, sName, sProfileImg, filePath, sentAt, msgId, fileType, fileName, false, 0, 0, 0, false, duration);
    });

    connection.on("GroupMessageStatusUpdated", function(messageId, gId, totalRecipients, deliveredCount, readCount) {
        const wrapper = document.querySelector(`div[data-message-id="${messageId}"]`);
        if (!wrapper) return;

        if (!messageStatusMap[messageId]) {
            messageStatusMap[messageId] = {};
        }
        messageStatusMap[messageId].deliveredCount = deliveredCount;
        messageStatusMap[messageId].readCount = readCount;
        messageStatusMap[messageId].totalRecipients = totalRecipients;

        updateGroupMessageTick(messageId);
    });

    function updateGroupMessageTick(msgId) {
        const wrapper = document.querySelector(`div[data-message-id="${msgId}"]`);
        if (!wrapper) return;

        const status = messageStatusMap[msgId];
        if (!status) return;

        const statusSpan = wrapper.querySelector('.message-status');
        if (!statusSpan) return;

        const tCount = status.totalRecipients || 0;
        const dCount = status.deliveredCount || 0;
        const rCount = status.readCount || 0;

        if (tCount > 0 && rCount >= tCount) {
            statusSpan.innerHTML = '<i class="fas fa-check-double"></i>';
            statusSpan.className = 'message-status read';
            statusSpan.title = 'Read by everyone';
        } else if (tCount > 0 && dCount >= tCount) {
