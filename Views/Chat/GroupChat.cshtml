    const _vmTimers = {};
function toggleVoicePlay(btn) {
  const bubble = btn.closest('.voice-bubble-inner');
  const src = bubble.dataset.src;
  const bars = [...bubble.querySelectorAll('.vm-bar')];
  const durEl = bubble.querySelector('.vm-dur');
  const id = src;
  if (_vmTimers[id]) {
    clearInterval(_vmTimers[id]); _vmTimers[id] = null;
    btn.innerHTML = '<i class="fas fa-play"></i>'; return;
  }
  const audio = new Audio(src);
  audio.play();
  btn.innerHTML = '<i class="fas fa-pause"></i>';
  _vmTimers[id] = setInterval(() => {
    if (!audio.duration) {
      // Duration not yet known — show elapsed time and animate bars sequentially
      const elapsed = audio.currentTime;
      const assumedMax = 60; // assume 60 seconds if duration unknown
      const pct = Math.min(elapsed / assumedMax, 1);
      const played = Math.floor(pct * bars.length);
      bars.forEach((b, i) => b.classList.toggle('played', i < played));
      durEl.textContent = Math.floor(elapsed / 60) + ':' + String(Math.floor(elapsed % 60)).padStart(2, '0');
      return;
    }
    const pct = audio.currentTime / audio.duration;
    const played = Math.floor(pct * bars.length);
    bars.forEach((b, i) => b.classList.toggle('played', i < played));
    const left = audio.duration - audio.currentTime;
    durEl.textContent = Math.floor(left/60)+':'+String(Math.floor(left%60)).padStart(2,'0');
    if (audio.ended) {
      clearInterval(_vmTimers[id]); _vmTimers[id] = null;
      btn.innerHTML = '<i class="fas fa-play"></i>';
      bars.forEach(b => b.classList.remove('played'));
    }
  }, 200);
}
const _speeds = ['1×','1.5×','2×'];
function cycleVmSpeed(btn) {
  const cur = _speeds.indexOf(btn.textContent);
  btn.textContent = _speeds[(cur+1) % _speeds.length];
  const audio = btn.closest('.voice-bubble-inner').querySelector('audio');
  if (audio) audio.playbackRate = parseFloat(_speeds[(cur+1)%_speeds.length]) || 1;
}

