    }

    .full-image-modal.show {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    }

    @@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
    }

    .modal-content {
