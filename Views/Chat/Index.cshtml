    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

 html, body {
    height: 100%;
    height: 100dvh;   /* ← add this line */
    overflow: hidden;
    background: #1a1a2e; /* ← add this as a solid fallback */
}
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100%;
    }

    .chat-container {
        max-width: 800px;
        margin: 0 auto;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: linear-gradient(180deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.04) 100%);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.4), 0 0 1px rgba(255,255,255,0.1) inset;
        border: 1px solid rgba(255,255,255,0.08);
        overflow: hidden;
    }

  @@media (max-width: 767px) {
    .chat-container {
        border-radius: 0;
        margin: 0;
        height: 100vh;
        height: 100dvh; /* dynamic viewport height for mobile browsers */
        box-shadow: none; /* removes the inset white glow */
    }

    /* Respect notch / home-bar safe area */
    .user-list {
        padding-bottom: env(safe-area-inset-bottom, 16px);
    }
}

    /* Header */
    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 30px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        color: white;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 4px 30px rgba(99, 102, 241, 0.4);
        border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .logo-icon {
        width: 46px;
        height: 46px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        animation: pulse 3s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .header-left h1 {
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.5px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.2);
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .search-box {
        position: relative;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        padding: 10px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .search-box:focus-within {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255,255,255,0.3);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
    }

    .search-box i {
        color: rgba(255, 255, 255, 0.8);
        font-size: 14px;
    }

    .search-box input {
        background: transparent;
        border: none;
        outline: none;
        color: white;
        font-size: 14px;
        width: 200px;
        font-weight: 500;
    }

    .search-box input::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .logout-btn {
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .logout-btn:hover {
        background: rgba(239, 68, 68, 0.8);
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
    }

    /* User List */
    .user-list {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
    }

    .user-item {
        display: flex;
        align-items: center;
        padding: 20px 30px;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        gap: 18px;
        margin: 6px 16px;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
    }

    .user-item::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
        border-radius: 20px;
    }

    .user-item:hover {
        background: rgba(255, 255, 255, 0.06);
        transform: translateX(8px);
    }

    .user-item:hover::before {
        opacity: 1;
    }

    .user-avatar-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .user-avatar {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 22px;
        font-weight: 700;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
        transition: all 0.3s ease;
    }

    .user-item:hover .user-avatar {
        transform: scale(1.1) rotate(3deg);
        box-shadow: 0 12px 35px rgba(99, 102, 241, 0.5);
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 18px;
    }

    .online-indicator {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 16px;
        height: 16px;
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        border-radius: 50%;
        border: 3px solid rgba(26, 26, 46, 1);
        box-shadow: 0 2px 10px rgba(16, 185, 129, 0.6);
        animation: onlinePulse 2s ease-in-out infinite;
    }

    @@keyframes onlinePulse {
        0%, 100% { box-shadow: 0 2px 10px rgba(16, 185, 129, 0.6); }
        50% { box-shadow: 0 2px 20px rgba(16, 185, 129, 0.9); }
    }

    .user-info {
        flex: 1;
        min-width: 0;
        position: relative;
        z-index: 1;
    }

    .user-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .user-name {
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        letter-spacing: -0.3px;
    }

    .msg-time {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 500;
    }

    .user-preview {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .last-message {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 300px;
        font-weight: 500;
    }

    .last-message i {
        margin-right: 6px;
        color: #a855f7;
    }

    .unread-badge {
        min-width: 26px;
        height: 26px;
        background: linear-gradient(135deg, #f43f5e 0%, #fb7185 100%);
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 12px;
        font-weight: 700;
        padding: 0 8px;
        box-shadow: 0 4px 15px rgba(244, 63, 94, 0.4);
        animation: badgePop 0.3s ease;
    }

    @@keyframes badgePop {
        0% { transform: scale(0); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    /* Empty State */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 100px 30px;
        text-align: center;
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        border-radius: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 42px;
        margin-bottom: 24px;
        box-shadow: 0 20px 50px rgba(99, 102, 241, 0.4);
        animation: float 4s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .empty-state h3 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
        letter-spacing: -0.5px;
    }

    .empty-state p {
        font-size: 15px;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 500;
    }

    /* Scrollbar */
    .user-list::-webkit-scrollbar {
        width: 8px;
    }

    .user-list::-webkit-scrollbar-track {
        background: transparent;
    }

    .user-list::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);
        border-radius: 4px;
    }

    .user-list::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, #818cf8 0%, #a78bfa 100%);
    }
    .close-upload-btn{
    position: absolute;
    top: 14px;
    right: 14px;
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    cursor: pointer;
    font-size: 16px;
    transition: 0.3s;
}

.close-upload-btn:hover{
    background: rgba(239, 68, 68, 0.8);
    transform: rotate(90deg);
}
    /* Responsive */
    @@media (max-width: 600px) {
        .chat-header {
            padding: 18px 20px;
            flex-direction: column;
            gap: 16px;
        }

        .header-right {
            width: 100%;
            justify-content: space-between;
        }

        .search-box {
            flex: 1;
        }

        .search-box input {
            width: 100%;
        }

        .user-item {
            padding: 16px 20px;
            margin: 4px 12px;
        }

        .user-item:hover {
            padding-left: 24px;
        }

        .user-avatar {
            width: 50px;
            height: 50px;
        }

        .last-message {
            max-width: 200px;
        }

        .group-popup-content {
            width: 90%;
            max-height: 80vh;
        }
    }

    /* ===== Moments Styles ===== */
    .moments-body { flex: 1; overflow-y: auto; scrollbar-width: none; }
    .moments-body::-webkit-scrollbar { display: none; }
    .pulse-bar { padding: 14px 16px 10px; }
    .pulse-label {
        font-size: 10px; font-weight: 700; letter-spacing: 1.5px;
        color: rgba(255,255,255,0.3); display: block; margin-bottom: 10px;
    }
    .pulse-track { display: flex; gap: 14px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
    .pulse-track::-webkit-scrollbar { display: none; }
    .pulse-node { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; }
    .pulse-ring { width: 64px; height: 64px; border-radius: 50%; padding: 3px; display: flex; align-items: center; justify-content: center; }
    .live-ring { background: linear-gradient(135deg, #a855f7, #6366f1); }
    .seen-ring { background: rgba(255,255,255,0.1); }
    .add-ring { background: transparent; border: 2px dashed rgba(168,85,247,0.5); }
    .pulse-inner {
        width: 100%; height: 100%; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; font-weight: 700; color: #fff;
        border: 2px solid #1a1a2e;
    }
    .add-inner { background: rgba(99,102,241,0.2); border: none; color: #a855f7; font-size: 22px; }
    .seen-inner { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.35); }
    .pulse-name { font-size: 11px; color: rgba(255,255,255,0.45); font-weight: 500; max-width: 64px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .feed-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 4px 0; }
    .moments-feed { padding: 8px 14px 20px; display: flex; flex-direction: column; gap: 12px; }
    .moment-card {
        border-radius: 18px; overflow: hidden;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.07);
        transition: transform 0.2s ease;
    }
    .moment-card:hover { transform: translateY(-2px); }
    .card-header { display: flex; align-items: center; gap: 10px; padding: 11px 14px 9px; }
    .card-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
    }
    .card-meta { flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .card-name { font-size: 13px; font-weight: 600; color: #fff; }
    .card-time { font-size: 11px; color: rgba(255,255,255,0.35); }
    .live-badge {
        font-size: 10px; font-weight: 700; letter-spacing: 0.5px;
        padding: 3px 9px; border-radius: 20px;
        background: rgba(168,85,247,0.18); color: #c084fc;
    }
    .live-badge i { font-size: 7px; vertical-align: 1px; animation: blink 1.5s infinite; }
    @@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
    .card-visual {
        width: 100%; aspect-ratio: 16/9;
        display: flex; align-items: center; justify-content: center;
        background: #000;
    }
    .card-visual img, .card-visual video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .card-footer { padding: 10px 14px 12px; }
    .card-caption { font-size: 13px; color: rgba(255,255,255,0.7); line-height: 1.5; margin-bottom: 10px; }
    .card-actions { display: flex; gap: 7px; }
    .act-btn {
        flex: 1; padding: 8px 0;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        color: rgba(255,255,255,0.5); font-size: 12px; font-weight: 600;
        cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 5px;
        transition: all 0.2s;
    }
    .act-btn:hover { background: rgba(168,85,247,0.12); border-color: rgba(168,85,247,0.35); color: #c084fc; }
    .act-btn.lit { background: rgba(168,85,247,0.2); border-color: rgba(168,85,247,0.45); color: #e879f9; }
   .upload-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(10,8,20,0.75);
    z-index: 9999;
    align-items: flex-end;
    backdrop-filter: blur(6px);
}
    .upload-overlay.open { display: flex; }
    .upload-sheet {
    width: 100%;
    background: #1c1a30;
    border-radius: 24px 24px 0 0;
    padding: 16px 20px 28px;
    border-top: 1px solid rgba(255,255,255,0.1);
    animation: slideUp 0.3s cubic-bezier(0.32,0.72,0,1);
    max-height: 90vh;
    overflow-y: auto;
    box-sizing: border-box;
}
    @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .sheet-handle {
        width: 40px; height: 4px;
        background: rgba(255,255,255,0.15);
        border-radius: 2px; margin: 0 auto 18px;
    }
    .sheet-title {
        font-size: 16px; font-weight: 700; color: #fff;
        margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
    }
    .sheet-title i { color: #a855f7; }
    .drop-zone {
        width: 100%;
        min-height: 180px;
        border: 2px dashed rgba(99,102,241,0.4);
        border-radius: 16px;
        background: rgba(99,102,241,0.06);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 6px; cursor: pointer;
        transition: all 0.25s ease;
        position: relative; overflow: hidden;
        margin-bottom: 12px;
    }
    .moment-delete-btn {
    margin-left: auto; background: none; border: none;
    color: rgba(255,255,255,0.3); font-size: 14px; cursor: pointer;
    padding: 4px 8px; border-radius: 8px; transition: all 0.2s;
}
.moment-delete-btn:hover { color: #ef4444; background: rgba(239,68,68,0.15); }
    .drop-zone:hover, .drop-zone.drag-over {
        border-color: rgba(168,85,247,0.7);
        background: rgba(168,85,247,0.1);
    }
    .drop-icon { font-size: 38px; color: rgba(168,85,247,0.5); margin-bottom: 4px; transition: transform 0.2s; }
    .drop-zone:hover .drop-icon { transform: scale(1.1); color: rgba(168,85,247,0.8); }
    .drop-title { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.7); }
    .drop-sub { font-size: 12px; color: rgba(255,255,255,0.3); }
    .preview-img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; border-radius: 14px; }
    .clear-btn {
        position: absolute; top: 10px; right: 10px;
        background: rgba(0,0,0,0.6); color: #fff;
        border: none; border-radius: 8px;
        padding: 5px 10px; font-size: 11px; font-weight: 600;
        cursor: pointer; z-index: 2; display: flex; align-items: center; gap: 4px;
    }
    .caption-input {
        width: 100%; padding: 12px 14px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        color: #fff; font-size: 13px;
        outline: none; margin-bottom: 14px;
        transition: border-color 0.2s;
    }
    .caption-input::placeholder { color: rgba(255,255,255,0.3); }
    .caption-input:focus { border-color: rgba(168,85,247,0.5); }
    .sheet-actions { display: flex; gap: 10px; }
    .btn-cancel {
        flex: 1; padding: 13px;
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 14px; color: rgba(255,255,255,0.6);
        font-size: 14px; font-weight: 600; cursor: pointer;
        transition: all 0.2s;
    }
    .btn-cancel:hover { background: rgba(255,255,255,0.12); }
    .btn-upload {
        flex: 2; padding: 13px;
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border: none; border-radius: 14px;
        color: #fff; font-size: 14px; font-weight: 700;
        cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
        transition: all 0.2s; opacity: 0.4;
