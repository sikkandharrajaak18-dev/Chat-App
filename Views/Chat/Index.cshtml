    margin-right: 10px;
    }

    .selected-file span {
    color: #34d399;
    font-size: 14px;
    font-weight: 600;
    }

    .upload-btn {
    width: 100%;
    padding: 16px 24px;
    border: none;
    border-radius: 14px;
    color: white;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
