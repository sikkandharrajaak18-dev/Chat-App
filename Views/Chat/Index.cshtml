@model List<ChatConversationItem>
@using Chat_App.Models
@functions {
    string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <div class="header-left">
            <div class="logo-icon">
                <i class="fas fa-comments"></i>
            </div>
            <h1>Messages</h1>
        </div>
        <div class="header-right">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Search conversations..." onkeyup="filterUsers()" />
            </div>
            
            <div class="settings-wrapper">
                   @if (ViewBag.IsAdmin != true)
                {
                    <button class="settings-btn" onclick="CreateGroup()" title="Create Group">
                        <i class="fa-solid fa-plus"></i>
                    </button>

                    <button class="settings-btn" onclick="window.location.href='/Chat/Friends'" title="Add Friends">
                        <i class="fas fa-user-plus"></i>
                    </button>                        
                }

                <button class="settings-btn" onclick="toggleSettings()" title="Settings">
                    <i class="fas fa-cog"></i>
                </button>

                <div class="settings-dropdown" id="settingsDropdown">
                    <button class="menu-item" onclick="openUploadSection()">
                        <i class="fas fa-image"></i> Upload Profile 
                    </button>
                    @if (ViewBag.IsAdmin != true)
                    {
                        <button class="menu-item" onclick="hidechat()">
                            <i class="fa-solid fa-eye-slash"></i> Hide Chat
                        </button>            
                    }
                    <button class="menu-item" onclick="StaredMessage()">
                       <i class="fa-regular fa-star"></i>Stared Messages
                    </button>
                     <button class="menu-item" onclick="yourProfile()">
                      <i class="fa-solid fa-image-portrait"></i>Profile
                    </button>
                </div>
               
                <div class="upload-popup" id="uploadPopup">
                    <div class="upload-content">
                        <button class="close-upload-btn" onclick="closeUploadPopup()">
        <i class="fas fa-times"></i>
    </button>
                        <div class="profile-avatar-section">
                            <div class="profile-avatar-preview" id="profileAvatarPreview" onclick="showFullProfileImage()" style="cursor: pointer;">
                                @if (!string.IsNullOrEmpty(ViewBag.CurrentUserProfileImage))
                                {
                                    <img src="@ViewBag.CurrentUserProfileImage" alt="Profile" id="previewImage" />
                                }
                                else
                                {
                                    <div class="avatar-initial" id="avatarInitial">@ViewBag.CurrentUserUsername?.Substring(0, 1).ToUpper()</div>
                                }
                            </div>
                            <div class="profile-status" id="profileStatus">
                                <span class="status-text">@(!string.IsNullOrEmpty(ViewBag.CurrentUserProfileImage) ? "Click image to view full size" : "Add a photo")</span>
                            </div>
                        </div>

                        <div class="upload-area" id="uploadArea">
                            <input type="file" name="profileImage" id="profileImageInput" accept="image/*" class="file-input-hidden" />
                            <div class="upload-placeholder" onclick="document.getElementById('profileImageInput').click()">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span>Click to upload</span>
                            </div>
                            <div class="selected-file" id="selectedFile" style="display: none;">
                                <i class="fas fa-check-circle"></i>
                                <span id="fileName"></span>
                            </div>
                        </div>

                        <button type="button" class="upload-btn" id="uploadBtn" onclick="uploadProfile()">
                            <i class="fas fa-upload"></i> Upload Photo
                        </button>

                        <div class="upload-success" id="uploadSuccess">
                            <i class="fas fa-check-circle"></i>
                            <span>Uploaded successfully!</span>
                        </div>
                    </div>
                </div>
                <!-- Group Popup -->
<div class="group-popup" id="groupPopup">
    <div class="group-popup-content">

        <div class="group-header">
            <h3 class="text-black">Create Group</h3>
            <button class="close-group-btn" onclick="closeGroupPopup()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="group-users-list">

            <div class="group-user-item">

                <input type="checkbox"
                       checked
                       disabled />

                <div class="group-user-avatar">

                    @if (!string.IsNullOrEmpty(ViewBag.CurrentUserProfileImage))
                    {
                        <img src="@ViewBag.CurrentUserProfileImage" />
                    }
                    else
                    {
                        <span>
                            @ViewBag.CurrentUserUsername.Substring(0,1).ToUpper()
                        </span>
                    }

                </div>

                <span class="group-username text-black">
                    @ViewBag.CurrentUserUsername (You)
                </span>

            </div>

            @foreach (var item in Model)
            {
                @if (!item.IsGroup && !item.IsAdmin)
                {
                    <div class="group-user-item">

                        <input type="checkbox"
                               name="selectedUsers"
                               value="@item.Id" />

                        <div class="group-user-avatar">

                            @if (!string.IsNullOrEmpty(item.ProfileImagePath))
                            {
                                <img src="@item.ProfileImagePath" />
                            }
                            else
                            {
                                <span>
                                    @item.DisplayName.Substring(0,1).ToUpper()
                                </span>
                            }

                        </div>

                        <span class="group-username text-black">
                            @item.DisplayName
                        </span>

                    </div>
                }
            }

        </div>

        <div class="group-footer">
            <input type="text"
                   id="groupName"
                   placeholder="Enter group name"
                   class="group-name-input" />

            <button class="create-group-btn" onclick="createGroup()">
                Create Group
            </button>
        </div>

    </div>
</div>

                <!-- Full Image Preview Modal -->
                <div class="full-image-modal" id="fullImageModal" onclick="closeFullImageModal()">
                    <span class="close-modal">&times;</span>
                    <img class="modal-content" id="fullImagePreview" />
                    <div class="modal-caption">@ViewBag.CurrentUserUsername</div>
                </div>
            </div>

            <a href="/Account/Logout" class="logout-btn" title="Logout">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </div>
    <div class="tab-nav">
        @if (ViewBag.IsAdmin != true)
        {
            <a href="#" class="tab-item active" onclick="showTab('chats'); return false;">

                <i class="fas fa-comment-dots"></i> All Users
            </a>            
        }
         else
        {
            <a href="#" class="tab-item active" onclick="showTab('chats'); return false;">

                <i class="fas fa-comment-dots"></i> All Users
            </a>            
        }
        @if (ViewBag.IsAdmin != true)
