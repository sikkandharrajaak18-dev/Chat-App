    function toggleLike(btn) {
        btn.classList.toggle('lit');
        const s = btn.querySelector('span');
        const n = parseInt(s.textContent);
        const liked = btn.classList.contains('lit');
        s.textContent = liked ? n + 1 : n - 1;
        btn.querySelector('i').className = liked ? 'fas fa-heart' : 'far fa-heart';
    }
    function viewMoment(momentId, btn) {
        fetch('/Chat/MarkMomentViewed', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'momentId=' + momentId
        });
        fetch('/Chat/GetMomentViews?momentId=' + momentId)
            .then(r => r.json())
            .then(views => {
                const s = btn.querySelector('span');
                s.textContent = views.length;
            });
    }
    function showMomentViewer(userId) {
        const momentsFeed = document.getElementById('momentsFeed');
        const firstMoment = momentsFeed.querySelector('.moment-card[data-user-id="' + userId + '"]');
        if (firstMoment) firstMoment.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    function updateTimeRemaining() {
        document.querySelectorAll('.time-remaining').forEach(function (el) {
            const expires = new Date(el.getAttribute('data-expires'));
            const now = new Date();
            const diff = expires - now;
           if (isNaN(diff) || diff <= 0) { el.textContent = 'Expired'; return; }
            const h = Math.floor(diff / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            el.textContent = h + 'h ' + m + 'm remaining';
        });
    }
    updateTimeRemaining();
    setInterval(updateTimeRemaining, 60000);

    // Restore active tab after page reload
    var savedTab = sessionStorage.getItem('activeTab');
    if (savedTab) {
        sessionStorage.removeItem('activeTab');
        showTab(savedTab);
    }
    function formatChatTimestamps() {
    document.querySelectorAll('.msg-time[data-utc]').forEach(function (el) {
        var d = new Date(el.getAttribute('data-utc'));
        var now = new Date();

        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);

        var md = new Date(d.getFullYear(), d.getMonth(), d.getDate());

        var ts = d.toLocaleTimeString([], {
            hour: 'numeric',
            minute: '2-digit'
        });

        if (md.getTime() === today.getTime()) {
            el.textContent = ts;
        }
        else if (md.getTime() === yesterday.getTime()) {
            el.textContent = 'Yesterday';
        }
        else if (d > new Date(now.getTime() - 7 * 86400000)) {
            el.textContent = d.toLocaleDateString([], {
                weekday: 'long'
            });
        }
        else {
            el.textContent = d.toLocaleDateString([], {
                month: 'numeric',
                day: 'numeric',
                year: 'numeric'
            });
        }
    });
}

formatChatTimestamps();
</script>
