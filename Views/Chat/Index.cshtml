</style>

<script>
    const currentUserId = parseInt('@User.FindFirstValue(ClaimTypes.NameIdentifier)');

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    connection.start()
        .then(function () {
            return connection.invoke("RegisterUser", currentUserId);
        })
        .catch(err => console.error("Connection failed: ", err));

    connection.on("UserStatusChanged", function (uhatserId, isOnline, lastSeen) {
        updateUserOnlineStatus(userId, isOnline);
    });

    function updateUserOnlineStatus(userId, isOnline) {
        const userItems = document.querySelectorAll('.user-item');
        userItems.forEach(function (item) {
            const href = item.getAttribute('href');
            if (href && href.endsWith('/' + userId)) {
                let indicator = item.querySelector('.online-indicator');
                if (isOnline) {
                    if (!indicator) {
                        const wrapper = item.querySelector('.user-avatar-wrapper');
                        if (wrapper) {
                            indicator = document.createElement('span');
                            indicator.className = 'online-indicator';
                            wrapper.appendChild(indicator);
                        }
                    }
                } else {
                    if (indicator) indicator.remove();
                }
            }
        });
    }

    function yourProfile(){
        window.location.href='/Chat/Profile';
    }
    function updateConversationItem(convId, text, time, isGroup, fileType, fileName, isMine) {
        const userItems = document.querySelectorAll('.user-item');
        let targetItem = null;
        let targetIndex = -1;

        userItems.forEach(function (item, index) {
            const href = item.getAttribute('href');
            if (!href) return;
            if (isGroup) {
                if (href === '/Chat/GroupChat/' + convId) {
                    targetItem = item;
                    targetIndex = index;
                }
            } else {
                if (href === '/Chat/Chat/' + convId) {
                    targetItem = item;
                    targetIndex = index;
                }
            }
        });

        if (!targetItem) return;

        const now = new Date();
        const timeStr = now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', hour12: true });

        const msgTime = targetItem.querySelector('.msg-time');
        if (msgTime) msgTime.textContent = timeStr;

        const lastMsg = targetItem.querySelector('.last-message');
        if (lastMsg) {
            if (fileType) {
                let icon = '<i class="fas fa-image"></i>';
                if (fileType.startsWith('video/')) icon = '<i class="fas fa-video"></i>';
                else if (fileType === 'audio') icon = '<i class="fas fa-microphone"></i>';
                else if (!fileType.startsWith('image/')) icon = '<i class="fas fa-file"></i>';
                lastMsg.innerHTML = icon + ' ' + fileName;
            } else {
                lastMsg.textContent = text;
            }
        }

        if (!isMine) {
            let badge = targetItem.querySelector('.unread-badge');
            if (badge) {
                badge.textContent = parseInt(badge.textContent) + 1;
            } else {
                const preview = targetItem.querySelector('.user-preview');
                if (preview) {
                    badge = document.createElement('span');
                    badge.className = 'unread-badge';
                    badge.textContent = '1';
                    preview.appendChild(badge);
                }
            }
        }

        if (targetIndex > 0) {
            const userList = document.querySelector('.user-list');
            if (userList) userList.insertBefore(targetItem, userList.firstChild);
        }
    }

    connection.on("ReceiveMessage", function (senderId, message, msgId) {
        const isMine = senderId === currentUserId;
        updateConversationItem(senderId, message, null, false, null, null, isMine);
    });

    connection.on("ReceiveFileMessage", function (senderId, filePath, msgId, fileType, fileName) {
        const isMine = senderId === currentUserId;
        updateConversationItem(senderId, filePath, null, false, fileType, fileName, isMine);
    });

    connection.on("ReceiveGroupMessage", function (senderId, senderName, senderProfile, groupId, message, msgId, sentAt) {
        const isMine = senderId === currentUserId;
        const preview = isMine ? message : senderName + ': ' + message;
        updateConversationItem(groupId, preview, sentAt, true, null, null, isMine);
    });

    connection.on("ReceiveGroupFileMessage", function (senderId, senderName, senderProfile, groupId, filePath, msgId, fileType, fileName, sentAt) {
        const isMine = senderId === currentUserId;
        let preview;
        if (isMine) {
            preview = fileName;
        } else {
            const fileLabel = fileType === 'audio' ? 'voice message' : (fileType || 'file');
            preview = senderName + ' shared a ' + fileLabel;
        }
        updateConversationItem(groupId, preview, sentAt, true, fileType, fileName, isMine);
    });

    async function createGroup() {

    const groupName = document.getElementById("groupName").value;

    if (!groupName.trim()) {
        alert("Enter group name");
        return;
    }

    // Get selected users
    const selectedUsers = [];

    document.querySelectorAll('input[name="selectedUsers"]:checked')
        .forEach(cb => {
            selectedUsers.push(parseInt(cb.value));
        });

    if (selectedUsers.length === 0) {
        alert("Select at least one user");
        return;
    }

    const data = {
        groupName: groupName,
        userIds: selectedUsers
    };

    try {

        const response = await fetch('/Chat/CreateGroup', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });
if (response.ok) {

    alert("Group created successfully");

    window.location.href = "/Chat/Index";
}
        else {
            alert("Failed to create group");
        }

    } catch (error) {
        console.log(error);
        alert("Error creating group");
    }
}

function closeUploadPopup() {
    document.getElementById("uploadPopup").classList.remove("active");
}

    function filterUsers() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        const userItems = document.querySelectorAll('.user-item');

        userItems.forEach(item => {
            const userName = item.querySelector('.user-name').textContent.toLowerCase();
            if (userName.includes(searchValue)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }
   function StaredMessage() {
   window.location.href='/Chat/StaredMessages';
}
    function toggleSettings() {
    document.getElementById("settingsDropdown").classList.toggle("active");
    }

    function openUploadSection() {
    document.getElementById("uploadPopup").classList.toggle("active");
    }

    // Full Profile Image Modal
    function showFullProfileImage() {
    const profileImageSrc = '@ViewBag.CurrentUserProfileImage';
    if (profileImageSrc && profileImageSrc.length > 0) {
        const modal = document.getElementById('fullImageModal');
        const modalImg = document.getElementById('fullImagePreview');
        modalImg.src = profileImageSrc;
        modal.classList.add('show');
    }
    }
  function CreateGroup() {
    document.getElementById("groupPopup").classList.add("show-group-popup");
}

function closeGroupPopup() {
    document.getElementById("groupPopup").classList.remove("show-group-popup");
}

    function closeFullImageModal() {
    document.getElementById('fullImageModal').classList.remove('show');
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeFullImageModal();
    }
    });

    // Profile Image Upload
    const profileImageInput = document.getElementById('profileImageInput');
    const selectedFileDiv = document.getElementById('selectedFile');
    const fileNameSpan = document.getElementById('fileName');
    const uploadBtn = document.getElementById('uploadBtn');

    profileImageInput.addEventListener('change', function(e) {
        if (this.files && this.files[0]) {
            const file = this.files[0];
            fileNameSpan.textContent = file.name;
            selectedFileDiv.style.display = 'flex';
            document.querySelector('.upload-placeholder').style.display = 'none';
        }
    });

    async function uploadProfile() {
        const fileInput = document.getElementById('profileImageInput');
        const file = fileInput.files[0];

        if (!file) {
            alert('Please select a file first');
            return;
        }

        const formData = new FormData();
        formData.append('profileImage', file);

        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';

        try {
            const response = await fetch('/Account/UploadProfile', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const data = await response.json();

                // Show success message
                document.getElementById('uploadSuccess').classList.add('show');

                // Update avatar preview with new image
                const previewContainer = document.getElementById('profileAvatarPreview');
                previewContainer.innerHTML = `<img src="${data.imageUrl}" alt="Profile" id="previewImage" />`;

                // Update status text
                document.querySelector('.status-text').textContent = 'Change your photo';

                // Reset file input
                fileInput.value = '';
                selectedFileDiv.style.display = 'none';
                document.querySelector('.upload-placeholder').style.display = 'block';

                // Hide success message after 3 seconds
                setTimeout(() => {
                    document.getElementById('uploadSuccess').classList.remove('show');
                }, 3000);
            } else {
                const error = await response.text();
                alert('Upload failed: ' + error);
            }
        } catch (error) {
            alert('Error uploading file: ' + error.message);
        } finally {
            uploadBtn.disabled = false;
            uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload Photo';
        }
    }

    function hidechat() {
        window.location.href = '/Chat/HiddenAccess';
    }

    function showAbout() {
    alert("Chat Application v1.0");
    }

    document.addEventListener("click", function (e) {
    const wrapper = document.querySelector(".settings-wrapper");

    if (!wrapper.contains(e.target)) {
    document.getElementById("settingsDropdown").classList.remove("active");
    document.getElementById("uploadPopup").classList.remove("active");
    }
    });

    // ===== Tab Switching =====
    function showTab(tab) {
    const chatsTab = document.querySelector('.tab-item:first-child');
    const momentsTab = document.querySelector('.tab-item:last-child');
    const userList = document.querySelector('.user-list');
    const momentsBody = document.getElementById('momentsBody');
    if (tab === 'chats') {
        chatsTab.classList.add('active');
        momentsTab.classList.remove('active');
        userList.style.display = '';
        momentsBody.style.display = 'none';
        // Pause all moments videos
        document.querySelectorAll('#momentsFeed video').forEach(v => v.pause());
    } else {
        momentsTab.classList.add('active');
        chatsTab.classList.remove('active');
        userList.style.display = 'none';
        momentsBody.style.display = '';
    }
}

    // ===== Moments Upload =====
    let selectedFile = null;
    let selectedFileType = 'image';
    function openUpload() {
        document.getElementById('uploadOverlay').classList.add('open');
    }
    function closeUpload() {
        document.getElementById('uploadOverlay').classList.remove('open');
        clearFile(null);
    }
    function handleFile(e) {
        const file = e.target.files[0];
        if (file) showPreview(file);
    }
    function handleDrop(e) {
        e.preventDefault();
        document.getElementById('dropZone').classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file) showPreview(file);
    }
    function showPreview(file) {
        selectedFile = file;
        selectedFileType = file.type.startsWith('video/') ? 'video' : 'image';
        const img = document.getElementById('previewImg');
        const video = document.getElementById('previewVideo');
        img.style.display = 'none';
        video.style.display = 'none';
        if (selectedFileType === 'video') {
            video.src = URL.createObjectURL(file);
            video.style.display = 'block';
        } else {
            const reader = new FileReader();
            reader.onload = function (ev) {
                img.src = ev.target.result;
                img.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }
        document.getElementById('dropIcon').style.display = 'none';
        document.getElementById('dropTitle').style.display = 'none';
        document.getElementById('dropSub').style.display = 'none';
        document.getElementById('clearBtn').style.display = 'flex';
        document.getElementById('shareMomentBtn').disabled = false;
    }
    function clearFile(e) {
        if (e) e.stopPropagation();
        selectedFile = null;
        document.getElementById('previewImg').style.display = 'none';
        document.getElementById('previewImg').src = '';
        document.getElementById('previewVideo').style.display = 'none';
        document.getElementById('previewVideo').src = '';
        document.getElementById('dropIcon').style.display = 'block';
        document.getElementById('dropTitle').style.display = 'block';
        document.getElementById('dropSub').style.display = 'block';
        document.getElementById('clearBtn').style.display = 'none';
        document.getElementById('shareMomentBtn').disabled = true;
        document.getElementById('fileInput').value = '';
    }
    function uploadMoment() {
        if (!selectedFile) return;
        const btn = document.getElementById('shareMomentBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sharing...';
        btn.disabled = true;
        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('fileType', selectedFileType);
        formData.append('caption', document.getElementById('captionInput').value || '');
        fetch('/Chat/UploadMoment', {
            method: 'POST',
            body: formData
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                btn.innerHTML = '<i class="fas fa-check"></i> Shared!';
                setTimeout(function () {
                    closeUpload();
                    sessionStorage.setItem('activeTab', 'moments');
                    location.reload();
                }, 800);
            } else {
                alert('Upload failed: ' + data.error);
                btn.innerHTML = '<i class="fas fa-camera"></i> Share Moment';
                btn.disabled = false;
            }
        })
        .catch(function () {
            alert('Upload failed. Please try again.');
            btn.innerHTML = '<i class="fas fa-camera"></i> Share Moment';
            btn.disabled = false;
        });
    }
 async function deleteMoment(momentId, btn) {
const result = await Swal.fire({
    title: 'Delete this moment?',
    text: 'This will be permanently deleted.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#ef4444',
