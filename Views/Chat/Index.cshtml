    }

    .upload-placeholder span {
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    }

    .selected-file {
    border: 2px solid #10b981;
    border-radius: 16px;
    padding: 18px;
    background: rgba(16, 185, 129, 0.1);
    }

    .selected-file i {
