    @@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
    }

    /* Full Image Modal */
    .full-image-modal {
    display: none;
