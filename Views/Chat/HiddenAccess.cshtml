@{
    ViewData["Title"] = "Hidden Chat Access";
    var hasPassword = ViewBag.HasPassword;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="hidden-access-container">
    <div class="hidden-access-card">
        <div class="access-icon">
            <i class="fas fa-lock"></i>
        </div>
        <h2>@(hasPassword ? "Enter Hidden Password" : "Create Hidden Password")</h2>
        <p>@(hasPassword ? "Enter your password to access hidden chats" : "Set a password to protect your hidden chats")</p>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        <form method="post">
            <div class="password-input-group">
                <input type="password" name="password" placeholder="Enter password" required />
                <i class="fas fa-eye" onclick="togglePasswordVisibility(this)" style="cursor:pointer;"></i>
            </div>
            @if (!hasPassword)
            {
                <div class="password-input-group">
                        <input type="password" name="confirmPassword" placeholder="Confirm password" required />
                        <i class="fas fa-eye" onclick="togglePasswordVisibility(this)" style="cursor:pointer;"></i>
                </div>
            }
            <button type="submit" class="access-btn">
                <i class="fas fa-unlock"></i> @(hasPassword ? "Access Hidden Chats" : "Set Password")
            </button>
        </form>

        <a href="/Chat/Index" class="back-link"><i class="fas fa-arrow-left"></i> Back to Chats</a>
    </div>
</div>

<style>
    html, body {
        height: 100%;
        overflow: hidden;
        margin: 0;
    }
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .hidden-access-container {
        min-height: 100vh;
        width: 100%;
        overflow-y: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e0e7ff 0%, #f0e6ff 50%, #e8e0f7 100%);
        padding: 20px;
    }
    .hidden-access-card {
        background: white;
        border-radius: 24px;
        padding: 50px 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        text-align: center;
    }
    .access-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 24px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        color: white;
        box-shadow: 0 8px 25px rgba(102,126,234,0.35);
    }
    .hidden-access-card h2 {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 8px;
    }
    .hidden-access-card p {
        font-size: 15px;
        color: #6b7280;
        margin-bottom: 30px;
    }
    .error-message {
        background: #fef2f2;
        color: #dc2626;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 500;
    }
    .password-input-group {
        position: relative;
        margin-bottom: 16px;
    }
    /* Hide browser-native password reveal/clear buttons */
    .password-input-group input[type="password"]::-ms-reveal,
    .password-input-group input[type="password"]::-ms-clear {
        display: none;
    }
    .password-input-group input[type="password"]::-webkit-textfield-decoration-container,
    .password-input-group input[type="password"]::-webkit-credentials-auto-fill-button,
    .password-input-group input[type="password"]::-webkit-password-reveal-button {
        display: none !important;
        -webkit-appearance: none;
    }
    .password-input-group input {
        width: 100%;
        padding: 14px 44px 14px 16px;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        font-size: 15px;
        outline: none;
        transition: border-color 0.3s;
        box-sizing: border-box;
    }
    .password-input-group input:focus {
        border-color: #667eea;
    }
    .password-input-group i {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }
    .access-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 8px;
    }
    .access-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102,126,234,0.4);
    }
    .back-link {
        display: inline-block;
        margin-top: 24px;
        color: #667eea;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }
    .back-link:hover {
        text-decoration: underline;
    }
</style>

<script>
    function togglePasswordVisibility(icon) {
        const group = icon.closest('.password-input-group');
        const input = group ? group.querySelector('input[type="password"], input[type="text"]') : icon.previousElementSibling;
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>
