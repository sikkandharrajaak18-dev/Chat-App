            justify-content: space-between;
        }

        .search-box {
            flex: 1;
        }

        .search-box input {
            width: 100%;
        }

        .friends-tabs {
            padding: 12px 20px 0;
            overflow-x: auto;
        }

        .tab-btn {
            padding: 8px 14px;
            font-size: 13px;
            white-space: nowrap;
        }

        .friends-section {
            padding: 12px 20px;
        }

        .add-friend-item {
            padding: 12px;
        }

        .add-friend-avatar {
