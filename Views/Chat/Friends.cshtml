    .empty-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 32px;
        margin-bottom: 20px;
        box-shadow: 0 20px 50px rgba(99, 102, 241, 0.4);
    }

    .empty-state h3 {
        font-size: 20px;
        font-weight: 700;
