    }

    .add-friend-name {
        font-size: 16px;
        font-weight: 700;
        color: white;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .add-friend-status {
        font-size: 13px;
        color: rgba(255,255,255,0.5);
        margin-top: 4px;
    }

    .add-friend-btn {
        padding: 10px 20px;
        border: none;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .add-friend-btn.send {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
    }

    .add-friend-btn.send:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }

    .add-friend-btn.pending {
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
        cursor: default;
    }

    .add-friend-btn.accept {
        background: linear-gradient(135deg, #10b981, #34d399);
        color: white;
    }

    .add-friend-btn.accept:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
    }

    .add-friend-btn.reject {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    .add-friend-btn.reject:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: translateY(-1px);
    }

    .pending-request-item,
    .sent-request-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
        border-radius: 16px;
        background: rgba(255,255,255,0.03);
