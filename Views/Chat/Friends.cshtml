<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <div class="header-left">
            <a href="/Chat/Index" class="back-btn" title="Back to Messages">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div class="logo-icon">
                <i class="fas fa-user-friends"></i>
            </div>
            <h1>Friends</h1>
        </div>
        <div class="header-right">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="addFriendsSearch" placeholder="Search users..." onkeyup="filterAddFriends()" />
            </div>
            <a href="/Chat/Index" class="logout-btn" title="Back to Messages">
                <i class="fas fa-comments"></i>
            </a>
        </div>
    </div>

    <!-- Friend Requests Tabs -->
    <div class="friends-tabs">
        <button class="tab-btn active" onclick="switchTab('all')" id="tabAll">
            <i class="fas fa-users"></i> All Users
        </button>
        <button class="tab-btn" onclick="switchTab('pending')" id="tabPending">
            <i class="fas fa-user-clock"></i> Requests
        </button>
        <button class="tab-btn" onclick="switchTab('sent')" id="tabSent">
            <i class="fas fa-paper-plane"></i> Sent
        </button>
    </div>

    <!-- All Users Section -->
    <div class="friends-section active" id="sectionAll">
        <div class="friends-list" id="addFriendsList"></div>
        <div id="friendsLoader" style="display:flex;justify-content:center;padding:20px;">
            <div class="spinner"></div>
        </div>
    </div>

    <!-- Pending Requests Section -->
    <div class="friends-section" id="sectionPending">
        <div class="section-header">
            <h4>Friend Requests</h4>
        </div>
        <div class="friends-list" id="pendingRequestsList"></div>
    </div>

    <!-- Sent Requests Section -->
    <div class="friends-section" id="sectionSent">
        <div class="section-header">
            <h4>Sent Requests</h4>
        </div>
        <div class="friends-list" id="sentRequestsList"></div>
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
        overflow: hidden;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100%;
    }

    .chat-container {
        max-width: 800px;
        margin: 0 auto;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: linear-gradient(180deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.04) 100%);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.4), 0 0 1px rgba(255,255,255,0.1) inset;
        border: 1px solid rgba(255,255,255,0.08);
        overflow: hidden;
    }

    @@media (min-width: 768px) {
        .chat-container {
            margin: 30px auto;
            border-radius: 24px;
            height: calc(100vh - 60px);
        }
    }

    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 30px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        color: white;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 4px 30px rgba(99, 102, 241, 0.4);
        border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .back-btn {
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .back-btn:hover {
        background: rgba(255,255,255,0.25);
        transform: translateX(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .logo-icon {
        width: 46px;
        height: 46px;
