@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chat App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>

<div class="login-page">
    <div class="bg-grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="login-wrapper">
        <div class="login-card">

            <!-- ══════════════ PANEL 1: LOGIN ══════════════ -->
            <div id="panel-login">
                <div class="card-head">
                    <div class="icon-ring">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="white" class="bi bi-chat-dots-fill" viewBox="0 0 16 16">
                            <path d="M16 8c0 3.866-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.584.296-1.925.864-4.181 1.234-.2.032-.352-.176-.273-.362.354-.836.674-1.95.77-2.966C.744 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7zM5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 1a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                    </div>
                    <h2>Welcome Back</h2>
                    <p>Sign in to continue to Chat App</p>
                </div>

                <form asp-action="Login" method="post">
                    <div class="field-block" style="margin-bottom:1.25rem;">
                        <label class="field-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg>
                            Username or Email
                        </label>
                        <div class="input-icon-wrap">
                            <svg class="input-prefix-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg>
                            <input type="text" class="field-input field-input--icon" id="Username" name="Username" placeholder="Enter your username" required />
                        </div>
                    </div>
                    <div class="field-block" style="margin-bottom:1rem;">
                        <label class="field-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                            Password
                        </label>
                        <div class="pw-wrap">
                            <svg class="input-prefix-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                            <input type="password" class="field-input field-input--icon" id="Password" name="Password" placeholder="Enter your password" required />
                            <button type="button" class="pw-eye" id="togglePassword">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" id="eyeIcon"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
                            </button>
                        </div>
                    </div>

                   @if (ViewBag.SuccessMessage != null)
{
    <div class="alert-success mb-3" role="alert" id="successAlert" style="display:flex; align-items:center; justify-content:space-between; gap:8px;">
        <span>@ViewBag.SuccessMessage</span>
        <button type="button" onclick="document.getElementById('successAlert').style.display='none'" style="background:none; border:none; cursor:pointer; color:#6ee7b7; padding:0; line-height:1; flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
            </svg>
        </button>
    </div>
}
                 @if (ViewBag.ErrorMessage != null)
{
    <div class="alert-error mb-3" role="alert" id="errorAlert" style="display:flex; align-items:center; justify-content:space-between; gap:8px;">
        <span>@ViewBag.ErrorMessage</span>
        <button type="button" onclick="document.getElementById('errorAlert').style.display='none'" style="background:none; border:none; cursor:pointer; color:#fca5a5; padding:0; line-height:1; flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
            </svg>
        </button>
    </div>
}

                    <div class="remember-row">
                        <label class="remember-label">
                            <input class="remember-check" type="checkbox" id="rememberMe" name="RememberMe" value="true">
                            Remember me
                        </label>
                        <a href="#" class="forgot-link" id="openForgotPassword">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn-primary-action" style="margin-top:1.5rem;">
                        <span>Sign In</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/></svg>
                    </button>
                </form>

                <p class="signin-link" style="margin-top:1.25rem;">Don't have an account? <a asp-controller="Account" asp-action="Register" asp-route-reset="true">Sign Up</a></p>
            </div>

            <!-- ══════════════ PANEL 2: FORGOT PASSWORD — ENTER EMAIL ══════════════ -->
            <div class="hidden" id="panel-email">
                <div class="card-head">
                    <div class="icon-ring" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); box-shadow: 0 8px 24px rgba(79,172,254,0.35);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="white" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383-4.708 2.825L15 11.105V5.383zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741zM1 11.105l4.708-2.897L1 5.383v5.722z"/>
                        </svg>
                    </div>
                    <h2>Forgot Password</h2>
                    <p>Enter your email to receive a verification code</p>
                </div>

                <!-- Step indicator: 3 dots -->
                <div class="step-indicator" style="margin-bottom:1.75rem;">
                    <div class="step-dot active" id="fp-dot1"></div>
                    <div class="step-line" id="fp-line1"></div>
                    <div class="step-dot" id="fp-dot2"></div>
                    <div class="step-line" id="fp-line2"></div>
                    <div class="step-dot" id="fp-dot3"></div>
                </div>

                <div class="field-block" style="margin-bottom:1.25rem;">
                    <label class="field-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.758 2.855L15 11.114v-5.73Zm-.034 6.878L9.271 8.82 8 9.583 6.728 8.82l-5.694 3.44A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.739ZM1 11.114l4.758-2.876L1 5.383v5.73Z"/></svg>
                        Email Address
                    </label>
                    <div class="input-icon-wrap">
                        <svg class="input-prefix-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.758 2.855L15 11.114v-5.73Zm-.034 6.878L9.271 8.82 8 9.583 6.728 8.82l-5.694 3.44A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.739ZM1 11.114l4.758-2.876L1 5.383v5.73Z"/></svg>
                        <input type="email" class="field-input field-input--icon" id="fpEmail" placeholder="Enter your email address" required />
                    </div>
                    <span class="field-error hidden" id="fpEmailError"></span>
                </div>

                <button type="button" class="btn-primary-action" id="btnSendOtp" style="margin-bottom:1rem;">
                    <span>Send Verification Code</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/></svg>
                </button>

                <p class="signin-link">
                    <a href="#" id="backToLogin">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right:4px;"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/></svg>
                        Back to Login
                    </a>
                </p>
            </div>

            <!-- ══════════════ PANEL 3: ENTER OTP ══════════════ -->
            <div class="hidden" id="panel-otp">
                <div class="card-head">
                    <div class="icon-ring icon-ring--teal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="white" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/>
                        </svg>
                    </div>
                    <h2>Verify Code</h2>
                    <p>Enter the 6-digit code sent to <span id="otpEmailDisplay" style="color:#2dd4bf; font-weight:600;"></span></p>
                </div>

                <div class="step-indicator" style="margin-bottom:1.75rem;">
                    <div class="step-dot done" id="fp-dot1-otp"></div>
                    <div class="step-line active" id="fp-line1-otp"></div>
                    <div class="step-dot active" id="fp-dot2-otp"></div>
                    <div class="step-line" id="fp-line2-otp"></div>
                    <div class="step-dot" id="fp-dot3-otp"></div>
                </div>

                <div class="otp-container" style="margin-bottom:1rem;">
                    <input type="tel" class="otp-input" maxlength="1" />
                    <input type="tel" class="otp-input" maxlength="1" />
                    <input type="tel" class="otp-input" maxlength="1" />
                    <input type="tel" class="otp-input" maxlength="1" />
                    <input type="tel" class="otp-input" maxlength="1" />
                    <input type="tel" class="otp-input" maxlength="1" />
                </div>

                <div style="text-align:center; color:rgba(255,255,255,0.6); font-size:0.875rem; margin-bottom:1.25rem;">
                    Code expires in <span id="timerCount" style="color:#2dd4bf; font-weight:600;">05:00</span>
                </div>

                <span class="field-error hidden" id="fpOtpError" style="display:block; margin-bottom:0.75rem;"></span>

                <button type="button" class="btn-primary-action btn-complete-teal" id="btnVerifyOtp" style="margin-bottom:1rem;">
                    <span>Verify Code</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/></svg>
                </button>

                <p class="signin-link">
                    <span style="color:rgba(255,255,255,0.4);">Didn't receive the code?</span>
                    <a href="#" id="resendOtp" style="margin-left:6px;">Resend</a>
                    &nbsp;·&nbsp;
                    <a href="#" id="backToEmail">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right:3px;"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/></svg>Back
                    </a>
                </p>
            </div>

            <!-- ══════════════ PANEL 4: RESET PASSWORD ══════════════ -->
            <div class="hidden" id="panel-reset">
                <div class="card-head">
                    <div class="icon-ring" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); box-shadow: 0 8px 24px rgba(240,147,251,0.35);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="white" viewBox="0 0 16 16">
                            <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"/>
                        </svg>
                    </div>
                    <h2>New Password</h2>
                    <p>Create a strong new password for your account</p>
                </div>

                <div class="step-indicator" style="margin-bottom:1.75rem;">
                    <div class="step-dot done"></div>
                    <div class="step-line active"></div>
                    <div class="step-dot done"></div>
                    <div class="step-line active"></div>
                    <div class="step-dot active"></div>
                </div>

                <div class="field-block" style="margin-bottom:1.25rem;">
                    <label class="field-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                        New Password
                    </label>
                    <div class="pw-wrap">
                        <svg class="input-prefix-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                        <input type="password" class="field-input field-input--icon" id="newPassword" placeholder="Enter new password" />
                        <button type="button" class="pw-eye" onclick="togglePwd('newPassword','eyeNew')">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" id="eyeNew"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
                        </button>
                    </div>
                    <div class="pwd-strength" style="margin-top:6px;">
                        <div class="pwd-strength-bar" id="pwdStrengthBar"></div>
                    </div>
                    <small id="pwdStrengthLabel" class="field-hint"></small>
                </div>

                <div class="field-block" style="margin-bottom:1.25rem;">
                    <label class="field-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                        Confirm Password
                    </label>
                    <div class="pw-wrap">
                        <svg class="input-prefix-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                        <input type="password" class="field-input field-input--icon" id="confirmPassword" placeholder="Re-enter new password" />
                        <button type="button" class="pw-eye" onclick="togglePwd('confirmPassword','eyeConfirm')">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" id="eyeConfirm"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
                        </button>
                    </div>
                    <small id="pwdMatchLabel" class="field-hint"></small>
                </div>

                <span class="field-error hidden" id="fpResetError" style="display:block; margin-bottom:0.75rem;"></span>

                <button type="button" class="btn-primary-action btn-complete" id="btnResetPassword">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
                    <span>Reset Password</span>
                </button>
            </div>

            <!-- ══════════════ PANEL 5: SUCCESS ══════════════ -->
            <div class="hidden" id="panel-success">
                <div style="text-align:center; padding:1rem 0;">
                    <div class="success-circle" style="margin:0 auto 1.5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="white" viewBox="0 0 16 16">
                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                        </svg>
                    </div>
                    <h2 style="color:white; font-size:1.6rem; font-weight:700; margin-bottom:0.5rem;">Password Reset!</h2>
                    <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; margin-bottom:2rem;">Your password has been updated. You can now sign in with your new password.</p>
                    <button type="button" class="btn-primary-action" id="btnGoToLogin">
                        <span>Back to Login</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/></svg>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; }
    body { font-family: 'Sora', sans-serif; background: #0a0a12; }

    /* ── Page & Background ── */
    .login-page {
        min-height: 100vh; height: 100vh;
        background: radial-gradient(ellipse at 20% 20%, #1a0533 0%, #0a0a12 50%, #001428 100%);
        display: flex; align-items: center; justify-content: center;
        position: relative; overflow: hidden; padding: 2rem 1rem;
    }
    .login-wrapper {
        position: relative; z-index: 2; width: 100%;
        max-width: 480px; max-height: calc(100vh - 4rem); overflow: auto;
    }
    .bg-grid {
        position: absolute; inset: 0;
        background-image: linear-gradient(rgba(102,126,234,0.06) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(102,126,234,0.06) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    }
    .orb { position: absolute; border-radius: 50%; filter: blur(80px); animation: drift 18s ease-in-out infinite; }
    .orb-1 { width: 400px; height: 400px; background: rgba(102,126,234,0.18); top: -100px; left: -100px; }
    .orb-2 { width: 300px; height: 300px; background: rgba(167,139,250,0.15); bottom: -80px; right: -80px; animation-delay: -6s; }
    .orb-3 { width: 200px; height: 200px; background: rgba(52,211,153,0.1); top: 50%; left: 60%; animation-delay: -12s; }
    @@keyframes drift { 0%,100%{transform:translate(0,0)} 33%{transform:translate(40px,-30px)} 66%{transform:translate(-20px,40px)} }

    /* ── Card ── */
    .login-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 24px; padding: 2.5rem 2.5rem 2rem;
        backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
        box-shadow: 0 32px 80px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.08);
    }
    @@media (max-width: 500px) { .login-card { padding: 2rem 1.25rem 1.5rem; } }

    /* ── Step Indicator ── */
    .step-indicator { display: flex; align-items: center; justify-content: center; }
    .step-dot {
        width: 10px; height: 10px; border-radius: 50%;
        background: rgba(255,255,255,0.2); transition: all 0.4s ease; flex-shrink: 0;
    }
    .step-dot.active { background: #667eea; box-shadow: 0 0 12px rgba(102,126,234,0.6); transform: scale(1.3); }
    .step-dot.done   { background: #34d399; box-shadow: 0 0 10px rgba(52,211,153,0.5); }
    .step-line { width: 50px; height: 2px; background: rgba(255,255,255,0.1); transition: background 0.5s ease; flex-shrink: 0; }
    .step-line.active { background: linear-gradient(90deg, #667eea, #a78bfa); }

    /* ── Card Header ── */
    .card-head { text-align: center; margin-bottom: 2rem; }
    .icon-ring {
        width: 64px; height: 64px;
        background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        margin-bottom: 1rem; box-shadow: 0 8px 24px rgba(102,126,234,0.35);
        animation: halo 3s ease-in-out infinite;
    }
    .icon-ring--teal { background: linear-gradient(135deg, #0d9488, #2dd4bf); box-shadow: 0 8px 24px rgba(13,148,136,0.3); }
    @@keyframes halo { 0%,100%{box-shadow:0 8px 24px rgba(102,126,234,0.35)} 50%{box-shadow:0 8px 36px rgba(102,126,234,0.55)} }
    .card-head h2 { color: white; font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.3rem; }
    .card-head p  { color: rgba(255,255,255,0.5); font-size: 0.875rem; }

    /* ── Fields ── */
    .field-block { display: flex; flex-direction: column; gap: 6px; }
    .field-label {
        display: flex; align-items: center; gap: 6px;
        color: rgba(255,255,255,0.7); font-size: 0.8rem; font-weight: 600;
        letter-spacing: 0.04em; text-transform: uppercase;
    }
    .field-input {
        width: 100%; background: rgba(255,255,255,0.06);
        border: 1.5px solid rgba(255,255,255,0.12); border-radius: 10px;
        color: white; font-family: 'Sora', sans-serif; font-size: 0.9rem;
        padding: 11px 14px; transition: all 0.25s ease; outline: none;
    }
    .field-input::placeholder { color: rgba(255,255,255,0.3); }
    .field-input:focus { border-color: #667eea; background: rgba(102,126,234,0.08); box-shadow: 0 0 0 3px rgba(102,126,234,0.18); }
    .field-input.error { border-color: #f87171; box-shadow: 0 0 0 3px rgba(248,113,113,0.15); }
    .field-input--icon { padding-left: 42px; }
    .field-error { color: #f87171; font-size: 0.75rem; min-height: 1rem; }
    .field-hint  { color: rgba(255,255,255,0.35); font-size: 0.78rem; }

    /* Input with prefix icon */
    .input-icon-wrap { position: relative; }
    .input-prefix-icon {
        position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
        color: rgba(255,255,255,0.35); pointer-events: none; z-index: 1;
        transition: color 0.25s ease;
    }
    .input-icon-wrap:focus-within .input-prefix-icon { color: #667eea; }

    /* Password wrap */
    .pw-wrap { position: relative; }
    .pw-wrap .field-input { padding-left: 42px; padding-right: 40px; }
    .pw-wrap .input-prefix-icon { left: 14px; }
    .pw-eye {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        background: none; border: none; color: rgba(255,255,255,0.4);
        cursor: pointer; padding: 4px; display: flex; transition: color 0.2s;
    }
    .pw-eye:hover { color: #a78bfa; }

    /* Remember / Forgot row */
    .remember-row {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: 0.25rem;
    }
    .remember-label {
        display: flex; align-items: center; gap: 8px;
        color: rgba(255,255,255,0.65); font-size: 0.85rem; cursor: pointer;
    }
    .remember-check {
        width: 15px; height: 15px; border-radius: 4px;
        background: rgba(255,255,255,0.08); border: 1.5px solid rgba(255,255,255,0.2);
        accent-color: #667eea; cursor: pointer;
    }
    .forgot-link {
        color: rgba(255,255,255,0.65); font-size: 0.85rem; text-decoration: none;
        transition: color 0.2s ease;
    }
    .forgot-link:hover { color: #a78bfa; }

    /* ── Buttons ── */
    .btn-primary-action {
        width: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none; border-radius: 12px; color: white;
        font-family: 'Sora', sans-serif; font-size: 1rem; font-weight: 600;
        padding: 14px 20px; display: flex; align-items: center; justify-content: center;
        gap: 8px; cursor: pointer; transition: all 0.3s ease; position: relative; overflow: hidden;
    }
    .btn-primary-action::after { content:''; position:absolute; inset:0; background:linear-gradient(135deg,rgba(255,255,255,0.12),transparent); opacity:0; transition:opacity 0.3s; }
    .btn-primary-action:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(102,126,234,0.45); }
    .btn-primary-action:hover::after { opacity: 1; }
    .btn-primary-action:active { transform: translateY(0); }
    .btn-primary-action:disabled { opacity: 0.7; cursor: not-allowed; transform: none !important; }

    .btn-complete { background: linear-gradient(135deg, #059669 0%, #34d399 100%); }
    .btn-complete:hover { box-shadow: 0 12px 32px rgba(52,211,153,0.4); }
    .btn-complete-teal { background: linear-gradient(135deg, #0d9488 0%, #2dd4bf 100%); }
    .btn-complete-teal:hover { box-shadow: 0 12px 32px rgba(13,148,136,0.4); }

    /* Signin link */
    .signin-link { text-align: center; color: rgba(255,255,255,0.4); font-size: 0.85rem; margin-top: 1rem; }
    .signin-link a { color: #a78bfa; text-decoration: none; font-weight: 500; transition: color 0.2s; }
    .signin-link a:hover { color: #c4b5fd; }

    /* Alerts */
    .alert-error {
        background: rgba(248,113,113,0.12); border: 1px solid rgba(248,113,113,0.35);
        border-radius: 8px; color: #fca5a5; padding: 10px 14px; font-size: 0.85rem;
    }
    .alert-success {
        background: rgba(52,211,153,0.12); border: 1px solid rgba(52,211,153,0.35);
        border-radius: 8px; color: #6ee7b7; padding: 10px 14px; font-size: 0.85rem;
    }

    /* ── OTP inputs ── */
    .otp-container { display: flex; gap: 10px; justify-content: center; }
    .otp-input {
        width: 48px; height: 56px;
        background: rgba(255,255,255,0.06);
        border: 1.5px solid rgba(255,255,255,0.12);
        border-radius: 10px;
        color: white; font-family: 'Space Mono', monospace; font-size: 1.4rem; font-weight: 700;
        text-align: center; outline: none;
        transition: all 0.3s ease; caret-color: #667eea;
    }
    .otp-input:focus { border-color: #667eea; background: rgba(102,126,234,0.1); box-shadow: 0 0 0 3px rgba(102,126,234,0.18); }
    .otp-input.filled { border-color: #34d399; background: rgba(52,211,153,0.08); }

    /* ── Password strength ── */
    .pwd-strength { height: 4px; border-radius: 2px; background: rgba(255,255,255,0.1); overflow: hidden; }
    .pwd-strength-bar { height: 100%; width: 0%; border-radius: 2px; transition: width 0.4s ease, background 0.4s ease; }

    /* ── Success circle ── */
    .success-circle {
        width: 96px; height: 96px; border-radius: 50%;
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        display: inline-flex; align-items: center; justify-content: center;
        animation: successPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 12px 40px rgba(67,233,123,0.4);
    }
    @@keyframes successPop { 0%{transform:scale(0);opacity:0} 70%{transform:scale(1.1)} 100%{transform:scale(1);opacity:1} }

    /* ── Panel transitions ── */
    .hidden { display: none !important; }
    @@keyframes slideOut { from{opacity:1;transform:translateX(0)} to{opacity:0;transform:translateX(-30px)} }
    @@keyframes slideIn  { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }
</style>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ── Panel system ─────────────────────────────────────────────
    var fpEmail = '';
    var currentPanel = 'panel-login';
    var allPanels = ['panel-login','panel-email','panel-otp','panel-reset','panel-success'];

    function showPanel(id) {
        var hiding = document.getElementById(currentPanel);
        if (hiding) {
            hiding.style.animation = 'slideOut 0.28s ease forwards';
            setTimeout(function () {
                hiding.classList.add('hidden');
                hiding.style.animation = '';
                var target = document.getElementById(id);
                if (target) {
                    target.classList.remove('hidden');
                    target.style.animation = 'slideIn 0.35s ease forwards';
                    setTimeout(function () { target.style.animation = ''; }, 350);
                }
            }, 260);
        } else {
            allPanels.forEach(function (p) {
                var el = document.getElementById(p);
                if (el) el.classList.add('hidden');
            });
            var target = document.getElementById(id);
            if (target) {
                target.classList.remove('hidden');
                target.style.animation = 'slideIn 0.35s ease forwards';
                setTimeout(function () { target.style.animation = ''; }, 350);
            }
        }
        currentPanel = id;
    }

    function showError(id, msg) {
        var el = document.getElementById(id);
        if (!el) return;
        el.textContent = msg;
        el.classList.remove('hidden');
        el.style.display = 'block';
    }
    function hideError(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.textContent = '';
        el.classList.add('hidden');
        el.style.display = '';
    }

    // ── Password toggle ──────────────────────────────────────────
    function togglePwd(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            if (icon) icon.parentElement.style.color = '#a78bfa';
        } else {
            input.type = 'password';
            if (icon) icon.parentElement.style.color = 'rgba(255,255,255,0.4)';
        }
    }

    // ── Remember Me cookies ──────────────────────────────────────
    function getCookie(name) {
        var match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + '=([^;]*)'));
        return match ? decodeURIComponent(match[1]) : null;
    }
    function setCookie(name, value, days) {
        var expires = new Date(Date.now() + days * 864e5).toUTCString();
        document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires + '; path=/; SameSite=Lax';
    }
    function deleteCookie(name) {
        document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
    }

    // ── OTP helpers ──────────────────────────────────────────────
    function setupOtpInputs() {
        var inputs = document.querySelectorAll('.otp-input');
        inputs.forEach(function (inp, idx) {
            inp.addEventListener('input', function () {
                var val = this.value.replace(/\D/g,'');
                this.value = val ? val[0] : '';
                if (val && idx < inputs.length - 1) inputs[idx+1].focus();
                this.classList.toggle('filled', !!this.value);
            });
            inp.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && !this.value && idx > 0) {
                    inputs[idx-1].focus(); inputs[idx-1].value = ''; inputs[idx-1].classList.remove('filled');
                }
                if (e.key === 'ArrowLeft'  && idx > 0)                inputs[idx-1].focus();
                if (e.key === 'ArrowRight' && idx < inputs.length-1)  inputs[idx+1].focus();
            });
            inp.addEventListener('paste', function (e) {
                e.preventDefault();
                var pasted = (e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'');
                pasted.split('').slice(0,6).forEach(function (ch,i) {
                    if (inputs[i]) { inputs[i].value = ch; inputs[i].classList.add('filled'); }
                });
                if (inputs[Math.min(pasted.length,5)]) inputs[Math.min(pasted.length,5)].focus();
            });
            inp.addEventListener('focus', function () { this.select(); });
        });
    }

    function focusOtpInputs() {
        var inputs = document.querySelectorAll('.otp-input');
        inputs.forEach(function (i) { i.value = ''; i.classList.remove('filled'); });
        setTimeout(function () { inputs[0].focus(); }, 100);
    }

    // ── OTP timer ────────────────────────────────────────────────
    var timerInterval = null;
    function startOtpTimer() {
        clearOtpTimer();
        var seconds = 300;
        updateTimerDisplay(seconds);
        timerInterval = setInterval(function () {
            seconds--;
            updateTimerDisplay(seconds);
            if (seconds <= 0) clearOtpTimer();
        }, 1000);
    }
    function updateTimerDisplay(seconds) {
        var m = String(Math.floor(seconds/60)).padStart(2,'0');
        var s = String(seconds%60).padStart(2,'0');
        document.getElementById('timerCount').textContent = m+':'+s;
    }
    function clearOtpTimer() {
        if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
    }

    // ── Password strength ────────────────────────────────────────
    document.getElementById('newPassword').addEventListener('input', function () {
        var val = this.value;
        var bar = document.getElementById('pwdStrengthBar');
        var lbl = document.getElementById('pwdStrengthLabel');
        var score = 0;
        if (val.length >= 8)          score++;
        if (/[A-Z]/.test(val))        score++;
        if (/[0-9]/.test(val))        score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;
        var levels = [
            { pct:'0%',   bg:'transparent',                                     txt:'' },
            { pct:'25%',  bg:'#e24b4a',                                         txt:'Weak' },
            { pct:'50%',  bg:'#ef9f27',                                         txt:'Fair' },
            { pct:'75%',  bg:'#4facfe',                                         txt:'Good' },
            { pct:'100%', bg:'linear-gradient(90deg,#43e97b,#38f9d7)',          txt:'Strong' },
        ];
        bar.style.width      = levels[score].pct;
        bar.style.background = levels[score].bg;
        lbl.textContent      = levels[score].txt;
        lbl.style.color      = score < 2 ? '#e24b4a' : score < 3 ? '#ef9f27' : '#43e97b';
        checkPwdMatch();
    });
    document.getElementById('confirmPassword').addEventListener('input', checkPwdMatch);
    function checkPwdMatch() {
        var p1 = document.getElementById('newPassword').value;
        var p2 = document.getElementById('confirmPassword').value;
        var lbl = document.getElementById('pwdMatchLabel');
        if (!p2) { lbl.textContent = ''; return; }
        if (p1 === p2) { lbl.textContent = '✓ Passwords match'; lbl.style.color = '#43e97b'; }
        else           { lbl.textContent = '✗ Passwords do not match'; lbl.style.color = '#e24b4a'; }
    }

    // ── DOMContentLoaded ─────────────────────────────────────────
    window.addEventListener('DOMContentLoaded', function () {
        setupOtpInputs();
        // All panels hidden except login
        allPanels.forEach(function (p) {
            if (p !== 'panel-login') { var el = document.getElementById(p); if (el) el.classList.add('hidden'); }
        });
        // Restore remember me
        var savedUser = getCookie('rememberMe_username');
        var savedPwd  = getCookie('rememberMe_password');
        if (savedUser && savedPwd) {
            document.getElementById('Username').value    = savedUser;
            document.getElementById('Password').value    = savedPwd;
            document.getElementById('rememberMe').checked = true;
        }
        // Main login form submit
        var loginForm = document.querySelector('#panel-login form');
        if (loginForm) {
            loginForm.addEventListener('submit', function () {
                var username = document.getElementById('Username').value;
                var password = document.getElementById('Password').value;
                var remember = document.getElementById('rememberMe').checked;
                if (remember) { setCookie('rememberMe_username',username,30); setCookie('rememberMe_password',password,30); }
                else          { deleteCookie('rememberMe_username'); deleteCookie('rememberMe_password'); }
            });
        }
        // Password toggle on login
        document.getElementById('togglePassword').addEventListener('click', function () {
            togglePwd('Password','eyeIcon');
        });
        // Navigate to forgot password
        document.getElementById('openForgotPassword').addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('fpEmail').value = ''; fpEmail = '';
            hideError('fpEmailError'); hideError('fpOtpError'); clearOtpTimer();
            showPanel('panel-email');
        });
        document.getElementById('backToLogin').addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('fpEmail').value = ''; fpEmail = '';
            hideError('fpEmailError'); hideError('fpOtpError'); clearOtpTimer();
            showPanel('panel-login');
        });
        document.getElementById('backToEmail').addEventListener('click', function (e) {
            e.preventDefault(); clearOtpTimer(); showPanel('panel-email');
        });
        document.getElementById('btnGoToLogin').addEventListener('click', function () {
            showPanel('panel-login');
        });
    });

    // ── STEP 1: Send OTP ─────────────────────────────────────────
    document.getElementById('btnSendOtp').addEventListener('click', function () {
        var email = document.getElementById('fpEmail').value.trim();
        hideError('fpEmailError');
        if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            showError('fpEmailError','Please enter a valid email address.'); return;
        }
        fpEmail = email;
        var btn = this; btn.disabled = true; btn.querySelector('span').textContent = 'Checking...';
        fetch('/Account/CheckMail?email=' + encodeURIComponent(email))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.disabled = false; btn.querySelector('span').textContent = 'Send Verification Code';
                var exists = data.exist !== undefined ? data.exist : data.exists;
                if (exists === false) { showError('fpEmailError','No account found with this email address.'); return; }
                if (data.otpSent === false) { showError('fpEmailError', data.error || 'Failed to send OTP. Please try again.'); return; }
                document.getElementById('otpEmailDisplay').textContent = email;
                showPanel('panel-otp'); startOtpTimer(); focusOtpInputs();
            })
            .catch(function () {
                btn.disabled = false; btn.querySelector('span').textContent = 'Send Verification Code';
                showError('fpEmailError','Something went wrong. Please try again.');
            });
    });

    // ── STEP 2: Resend & Verify OTP ──────────────────────────────
    document.getElementById('resendOtp').addEventListener('click', function (e) {
        e.preventDefault();
        if (!fpEmail) { showPanel('panel-email'); return; }
        fetch('/Account/CheckMail?email=' + encodeURIComponent(fpEmail))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var exists = data.exist !== undefined ? data.exist : data.exists;
                if (exists === false) { showError('fpOtpError','Email no longer valid. Please go back.'); return; }
                var inputs = document.querySelectorAll('.otp-input');
                inputs.forEach(function (i) { i.value=''; i.classList.remove('filled'); });
                inputs[0].focus(); startOtpTimer(); hideError('fpOtpError');
            })
            .catch(function () { showError('fpOtpError','Something went wrong. Please try again.'); });
    });

    document.getElementById('btnVerifyOtp').addEventListener('click', function () {
        hideError('fpOtpError');
        var otp = Array.from(document.querySelectorAll('.otp-input')).map(function (i) { return i.value; }).join('');
        if (otp.length < 6) { showError('fpOtpError','Please enter all 6 digits of the verification code.'); return; }
        var btn = this; btn.disabled = true; btn.querySelector('span').textContent = 'Verifying...';
        fetch('/Account/VerifyOtp?email=' + encodeURIComponent(fpEmail) + '&otp=' + encodeURIComponent(otp))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.disabled = false; btn.querySelector('span').textContent = 'Verify Code';
                if (data.valid === false) { showError('fpOtpError','Invalid verification code. Please try again.'); return; }
                clearOtpTimer(); showPanel('panel-reset');
            })
            .catch(function () {
                btn.disabled = false; btn.querySelector('span').textContent = 'Verify Code';
                showError('fpOtpError','Something went wrong. Please try again.');
            });
    });

    // ── STEP 3: Reset password ────────────────────────────────────
    document.getElementById('btnResetPassword').addEventListener('click', function () {
        hideError('fpResetError');
        var newPwd  = document.getElementById('newPassword').value;
        var confPwd = document.getElementById('confirmPassword').value;
        if (newPwd.length < 8) { showError('fpResetError','Password must be at least 8 characters long.'); return; }
        if (newPwd !== confPwd) { showError('fpResetError','Passwords do not match. Please try again.'); return; }
        var btn = this; btn.disabled = true; btn.querySelector('span').textContent = 'Resetting...';
        fetch('/Account/ResetPassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ Email: fpEmail, NewPassword: newPwd })
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.disabled = false; btn.querySelector('span').textContent = 'Reset Password';
                if (data.success === false) { showError('fpResetError', data.error || 'Failed to reset password. Please try again.'); return; }
                showPanel('panel-success');
            })
            .catch(function () {
                btn.disabled = false; btn.querySelector('span').textContent = 'Reset Password';
                showError('fpResetError','Something went wrong. Please try again.');
            });
    });
</script>

</body>
</html>